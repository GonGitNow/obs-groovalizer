per_frame_init_1=smooth_bass = 1; smooth_treb = 1; beat_energy = 0; last_beat = 0; threshold = 1.4;
per_frame_1=smooth_bass = smooth_bass * 0.88 + bass * 0.12;
per_frame_2=smooth_treb = smooth_treb * 0.88 + treb * 0.12;
per_frame_3=vol = (bass + mid + treb) / 3;
per_frame_4=beat = above(bass, threshold) * above(time - last_beat, 0.2);
per_frame_5=last_beat = if(beat, time, last_beat);
per_frame_6=threshold = if(beat, bass + 0.4, threshold * 0.996 + 1.3 * 0.004);
per_frame_7=beat_energy = beat_energy * 0.93 + beat * 0.5;
per_frame_8=zoom = 1.04 + 0.01 * smooth_bass + beat_energy * 0.015;
per_frame_9=rot = 0.003 + 0.002 * sin(time * 0.15);
per_frame_10=decay = 0.98 + 0.015 * min(1, vol * 0.5);
per_frame_11=warp = 0.3 + 0.3 * smooth_treb;
per_frame_12=ob_r = 0.9 + 0.1 * sin(time * 0.2);
per_frame_13=ob_g = 0.45 + 0.15 * sin(time * 0.2 + 0.5);
per_frame_14=ob_b = 0.05 + 0.05 * sin(time * 0.3);
per_frame_15=ob_a = 0.6 + 0.3 * smooth_bass;
per_frame_16=ib_r = 1.0; ib_g = 0.55 + 0.1 * sin(time * 0.25); ib_b = 0.05;
per_frame_17=ib_a = 0.3 + 0.3 * smooth_bass;
per_frame_18=wave_r = 1.0; wave_g = 0.5 + 0.2 * sin(time * 0.3); wave_b = 0.1;
per_frame_19=wave_a = 0.5 + 0.3 * min(1, vol);
per_frame_20=q1 = smooth_bass; q2 = smooth_treb; q3 = beat_energy; q4 = vol; q5 = time;
per_pixel_1=zoom = zoom + 0.06 * rad * rad;
per_pixel_2=rot = rot + 0.002 * sin(ang * 2 + time * 0.1);
per_pixel_3=dx = 0.001 * cos(ang) * rad;
per_pixel_4=dy = 0.001 * sin(ang) * rad;
wavecode_0_enabled=1
wavecode_0_samples=256
wavecode_0_sep=0
wavecode_0_bSpectrum=0
wavecode_0_bUseDots=0
wavecode_0_bDrawThick=1
wavecode_0_bAdditive=1
