wavecode_0_smoothing=0.500000
wavecode_0_r=1.000000
wavecode_0_g=0.600000
wavecode_0_b=0.150000
wavecode_0_a=0.800000
wave_0_per_point1=ang2 = sample * 6.283185;
wave_0_per_point2=rad2 = 0.22 + 0.03 * sin(q5 * 0.4) + value1 * 0.06;
wave_0_per_point3=x = 0.5 + rad2 * cos(ang2) * aspecty;
wave_0_per_point4=y = 0.5 + rad2 * sin(ang2);
wave_0_per_point5=r = 1.0;
wave_0_per_point6=g = 0.5 + 0.3 * sin(sample * 6.28 + q5 * 0.5);
wave_0_per_point7=b = 0.1 + 0.1 * sin(sample * 6.28 + q5 * 0.3);
