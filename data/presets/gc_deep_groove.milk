per_frame_1=zoom = 1.0 + 0.04*bass - 0.01*treb;
per_frame_2=warp = 0.3 + 0.6*bass_att;
per_frame_3=fDecay = 0.94 + 0.03*bass_att;
per_frame_4=rot = 0.008*sin(time*0.1)*bass_att;
per_frame_5=wave_r = 0.8 + 0.2*bass_att;
per_frame_6=wave_g = 0.2 + 0.3*sin(time*0.25);
per_frame_7=wave_b = 0.05 + 0.15*cos(time*0.3);
