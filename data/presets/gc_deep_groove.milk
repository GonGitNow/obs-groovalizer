per_frame_9=dy = 0.003*cos(time*0.12)*mid_att;
per_frame_10=sx = 1.0 + 0.005*bass_att;
per_frame_11=sy = 1.0 + 0.005*bass_att;
per_pixel_1=zoom = zoom + 0.03*bass_att*(1.0 - rad*0.8);
per_pixel_2=rot = rot + 0.015*sin(ang*4.0)*bass_att*(1.0 - rad);
