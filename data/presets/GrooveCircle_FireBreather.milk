shapecode_0_border_b=0.050000
shapecode_0_border_a=0.600000
shape_0_per_frame1=spread = 0.15 + 0.1 * sin(q5 * 2 + instance * 0.8);
shape_0_per_frame2=x = 0.5 + spread * sin(instance * 0.785 + q5 * 1.5);
shape_0_per_frame3=y = 0.55 + spread * cos(instance * 0.785 + q5 * 1.5) * 0.5 - 0.1 * q1;
shape_0_per_frame4=rad = 0.02 + 0.03 * q4 + 0.01 * sin(instance + q5 * 5);
shape_0_per_frame5=border_r = 1.0;
shape_0_per_frame6=border_g = 0.2 + 0.5 * sin(q5 * 3 + instance);
shape_0_per_frame7=border_b = 0.02 + 0.08 * sin(q5 * 5 + instance * 2);
shape_0_per_frame8=border_a = 0.3 + 0.5 * q4;
shape_0_per_frame9=a = 0; a2 = 0;
