wavecode_0_g=0.500000
wavecode_0_b=0.100000
wavecode_0_a=0.900000
wave_0_per_point1=flame_y = 0.7 - value1 * 0.3 - abs(value1) * 0.2;
wave_0_per_point2=x = 0.2 + sample * 0.6;
wave_0_per_point3=y = flame_y + 0.05 * sin(sample * 25 + q5 * 8) * q1;
wave_0_per_point4=r = 1.0;
wave_0_per_point5=g = 0.3 + 0.5 * (1 - abs(value1));
wave_0_per_point6=b = 0.05 + 0.15 * max(0, -value1);
wave_0_per_point7=a = 0.7 + 0.3 * abs(value1);
wavecode_1_enabled=1
