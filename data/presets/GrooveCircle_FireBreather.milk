per_frame_init_1=sb = 1; sm = 1; st = 1; be = 0; lb = 0; th = 1.5;
per_frame_init_2=flame_h = 0; intensity = 0; flicker = 0;
per_frame_1=sb = sb * 0.75 + bass * 0.25;
per_frame_2=sm = sm * 0.8 + mid * 0.2;
per_frame_3=st = st * 0.8 + treb * 0.2;
per_frame_4=vol = (bass + mid + treb) / 3;
per_frame_5=beat = above(bass, th) * above(time - lb, 0.15);
per_frame_6=lb = if(beat, time, lb);
per_frame_7=th = if(beat, bass + 0.3, th * 0.995 + 1.4 * 0.005);
per_frame_8=be = be * 0.88 + beat * 0.7;
per_frame_9=intensity = intensity * 0.95 + vol * 0.05;
per_frame_10=flame_h = flame_h + 0.005 + be * 0.03;
per_frame_11=flicker = 0.8 + 0.2 * sin(time * 15) * sin(time * 23);
per_frame_12=zoom = 0.995 + 0.02 * sb * flicker;
per_frame_13=rot = 0.002 * sin(time * 0.5) + be * 0.04 * sin(time * 3);
per_frame_14=warp = 0.3 + 0.5 * sm;
per_frame_15=decay = 0.92 + 0.06 * min(1, vol * 0.6);
per_frame_16=cx = 0.5 + 0.03 * sin(time * 0.73);
per_frame_17=cy = 0.5 + 0.05 * sin(time * 0.53);
per_frame_18=dx = 0.001 * sin(time * 1.3);
per_frame_19=dy = -0.003 - 0.002 * sb;
per_frame_20=wave_r = 1.0; wave_g = 0.3 + 0.4 * sin(flame_h * 3); wave_b = 0.05 + 0.1 * be;
per_frame_21=wave_a = 0.8 + 0.2 * sb;
per_frame_22=echo_alpha = 0.15 + 0.15 * be;
per_frame_23=echo_zoom = 1.015;
per_frame_24=ob_r = 0.5 + 0.3 * sin(flame_h * 4); ob_g = 0.15 + 0.1 * sin(flame_h * 4 + 1);
per_frame_25=ob_b = 0.02; ob_a = 0.5 + 0.3 * be;
per_frame_26=q1 = sb; q2 = sm; q3 = st; q4 = be; q5 = flame_h; q6 = intensity;
per_pixel_1=dy = dy - 0.008 * (1 - rad) * sb;
per_pixel_2=zoom = zoom + 0.02 * sin(ang * 2 + time) * rad;
per_pixel_3=rot = rot + 0.01 * sin(ang * 4 + time * 2) * (1 - rad) * st;
per_pixel_4=dx = dx + 0.003 * sin(y * 12 + time * 3) * rad;
wavecode_0_enabled=1
wavecode_0_samples=256
wavecode_0_sep=0
wavecode_0_bSpectrum=0
