wavecode_1_a=0.500000
wave_1_per_point1=x = 0.1 + sample * 0.8;
wave_1_per_point2=y = 0.85 - value1 * 0.15;
wave_1_per_point3=r = 1.0; g = 0.6 + 0.4 * value1; b = 0.1;
wave_1_per_point4=a = 0.3 + 0.3 * value1;
