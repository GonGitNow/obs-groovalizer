per_frame_init_1=sb = 1; sm = 1; st = 1; be = 0; lb = 0; th = 1.4;
per_frame_init_2=kaleid_n = 6; phase = 0; energy = 0;
per_frame_1=sb = sb * 0.82 + bass * 0.18;
per_frame_2=sm = sm * 0.85 + mid * 0.15;
per_frame_3=st = st * 0.85 + treb * 0.15;
per_frame_4=vol = (bass + mid + treb) / 3;
per_frame_5=beat = above(bass, th) * above(time - lb, 0.18);
per_frame_6=lb = if(beat, time, lb);
per_frame_7=th = if(beat, bass + 0.35, th * 0.996 + 1.35 * 0.004);
per_frame_8=be = be * 0.9 + beat * 0.7;
per_frame_9=energy = energy * 0.97 + vol * 0.03;
per_frame_10=phase = phase + 0.004 + be * 0.02;
per_frame_11=zoom = 1.01 + 0.02 * sb + be * 0.03;
per_frame_12=rot = 0.015 + 0.01 * sin(time * 0.4) + be * 0.02;
per_frame_13=warp = 0.6 + 0.8 * sm;
per_frame_14=decay = 0.93 + 0.05 * min(1, vol * 0.6);
per_frame_15=echo_alpha = 0.45 + 0.1 * be;
per_frame_16=echo_zoom = 1.003 + 0.005 * sb;
per_frame_17=echo_orient = 2;
per_frame_18=wave_r = 0.7 + 0.3 * sin(phase * 6.28);
per_frame_19=wave_g = 0.2 + 0.3 * sin(phase * 6.28 + 2.5);
per_frame_20=wave_b = 0.6 + 0.4 * sin(phase * 6.28 + 4);
per_frame_21=wave_a = 0.5 + 0.3 * vol;
per_frame_22=ob_r = 0.3 + 0.2 * sin(phase * 4);
per_frame_23=ob_g = 0.05; ob_b = 0.4 + 0.2 * sin(phase * 4 + 2);
per_frame_24=ob_a = 0.4 + 0.4 * be;
per_frame_25=q1 = sb; q2 = sm; q3 = st; q4 = be; q5 = phase; q6 = energy;
per_pixel_1=new_ang = ang + 0.1 * sin(rad * 10 - time) * sm;
per_pixel_2=zoom = zoom + 0.05 * sin(new_ang * 6) * rad;
per_pixel_3=rot = rot + 0.06 * sin(new_ang * 6 + 1.57) * rad * (1 - rad);
per_pixel_4=dx = 0.004 * sin(new_ang * 6 + time * 0.5) * rad * rad;
per_pixel_5=dy = 0.004 * cos(new_ang * 6 + time * 0.5) * rad * rad;
wavecode_0_enabled=1
wavecode_0_samples=256
wavecode_0_sep=0
wavecode_0_bSpectrum=0
wavecode_0_bUseDots=0
