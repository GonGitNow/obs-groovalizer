wavecode_0_smoothing=0.500000
wavecode_0_r=0.900000
wavecode_0_g=0.300000
wavecode_0_b=0.800000
wavecode_0_a=0.800000
wave_0_per_point1=seg = floor(sample * 6);
wave_0_per_point2=local_t = sample * 6 - seg;
wave_0_per_point3=base_ang = seg * 1.0472 + q5 * 0.5;
wave_0_per_point4=r1 = 0.2 + 0.08 * sin(q5 * 3 + seg);
wave_0_per_point5=r2 = 0.2 + 0.08 * sin(q5 * 3 + seg + 1);
wave_0_per_point6=a1 = base_ang; a2_calc = base_ang + 1.0472;
wave_0_per_point7=px = (1 - local_t) * r1 * cos(a1) + local_t * r2 * cos(a2_calc);
wave_0_per_point8=py = (1 - local_t) * r1 * sin(a1) + local_t * r2 * sin(a2_calc);
wave_0_per_point9=x = 0.5 + (px + value1 * 0.03) * aspecty;
wave_0_per_point10=y = 0.5 + py + value2 * 0.03;
wave_0_per_point11=r = 0.7 + 0.3 * sin(q5 * 6.28 + seg * 1.05);
wave_0_per_point12=g = 0.2 + 0.3 * sin(q5 * 6.28 + seg * 1.05 + 2);
wave_0_per_point13=b = 0.6 + 0.4 * sin(q5 * 6.28 + seg * 1.05 + 4);
