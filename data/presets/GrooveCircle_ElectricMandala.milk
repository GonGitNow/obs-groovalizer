shapecode_0_border_b=0.700000
shapecode_0_border_a=0.500000
shape_0_per_frame1=ang = instance * 1.0472 + q5 * 0.4;
shape_0_per_frame2=rad = 0.18 + 0.04 * sin(q5 * 2 + instance) + q1 * 0.03;
shape_0_per_frame3=x = 0.5; y = 0.5;
shape_0_per_frame4=border_r = 0.6 + 0.4 * sin(q5 * 6.28 + instance * 1.05);
shape_0_per_frame5=border_g = 0.1 + 0.2 * sin(q5 * 6.28 + instance * 1.05 + 2);
shape_0_per_frame6=border_b = 0.5 + 0.3 * sin(q5 * 6.28 + instance * 1.05 + 4);
shape_0_per_frame7=border_a = 0.3 + 0.4 * q4;
shape_0_per_frame8=a = 0.1 + 0.1 * q4; a2 = 0.03;
