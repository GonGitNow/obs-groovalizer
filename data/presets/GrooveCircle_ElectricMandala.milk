shape_1_per_frame1=ang = instance * 1.0472 + q5 * -0.3 + 0.5236;
shape_1_per_frame2=rad = 0.1 + 0.03 * sin(q5 * 3 + instance * 0.7) + q2 * 0.02;
shape_1_per_frame3=x = 0.5; y = 0.5;
shape_1_per_frame4=border_r = 0.4 + 0.3 * sin(q5 * 6.28 + instance + 1);
shape_1_per_frame5=border_g = 0.08;
shape_1_per_frame6=border_b = 0.4 + 0.2 * sin(q5 * 6.28 + instance + 3);
shape_1_per_frame7=border_a = 0.25 + 0.3 * q4;
shape_1_per_frame8=a = 0.06 + 0.06 * q4; a2 = 0.02;
