per_frame_1=rot = 0.003 + 0.002*sin(time*0.04);
per_frame_2=zoom = 1.0 + 0.005*sin(time*0.03)*mid_att;
per_frame_3=dx = 0.002*sin(time*0.06);
per_frame_4=dy = 0.001*cos(time*0.05);
per_frame_5=warp = 0.3 + 0.3*sin(time*0.04) + 0.15*bass_att;
per_frame_6=wave_r = 0.4 + 0.3*sin(time*0.1);
per_frame_7=wave_g = 0.2 + 0.3*sin(time*0.12 + 2.0);
per_frame_8=wave_b = 0.8 + 0.2*cos(time*0.09);
per_frame_9=fDecay = 0.992 + 0.004*sin(time*0.025);
per_frame_10=fVideoEchoAlpha = 0.5 + 0.15*sin(time*0.035);
per_pixel_1=dx = dx + 0.003*cos(ang*3.0 + time*0.15)*mid_att;
per_pixel_2=dy = dy + 0.003*sin(ang*3.0 + time*0.15)*mid_att;
per_pixel_3=rot = rot + 0.002*sin(rad*6.283*2.0 + time*0.1);
per_pixel_4=zoom = zoom + 0.004*sin(rad*6.283)*bass_att;
