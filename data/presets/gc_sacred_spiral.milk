per_frame_1=rot = 0.02 + 0.01*sin(time*0.05) + 0.005*bass_att;
per_frame_2=zoom = 1.0 + 0.005*sin(time*0.08) + 0.01*mid_att;
per_frame_3=warp = 0.8 + 0.4*sin(time*0.07) + 0.3*bass_att;
per_frame_4=wave_r = 0.8 + 0.2*sin(time*0.2);
per_frame_5=wave_g = 0.6 + 0.3*sin(time*0.3 + 2.0);
per_frame_6=wave_b = 0.2 + 0.3*cos(time*0.25);
per_frame_7=fDecay = 0.98 + 0.01*sin(time*0.04);
per_frame_8=cx = 0.5 + 0.02*sin(time*0.06);
per_frame_9=cy = 0.5 + 0.02*cos(time*0.07);
per_pixel_1=zoom = zoom + 0.01*sin(ang*3.0 + time*0.3)*bass_att;
per_pixel_2=rot = rot + 0.005*sin(rad*6.283 + time*0.2);
per_pixel_3=warp = warp + 0.1*sin(ang*6.0)*mid_att;
