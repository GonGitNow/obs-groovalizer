shapecode_0=enabled=1,sides=6,additive=1,thickOutline=1,textured=0,num_inst=8,x=0.5,y=0.5,rad=0.200000,ang=0.000000,r=0.900000,g=0.750000,b=0.200000,r2=0.500000,g2=0.300000,b2=0.800000,a=0.800000,a2=0.600000,border_r=0.900000,border_g=0.700000,border_b=0.100000,border_a=1.000000
shape_0_per_frame_1=ang = instance * 0.785 + time * 0.08;
shape_0_per_frame_2=x = 0.5 + 0.18 * cos(instance * 0.785 + time * 0.05);
shape_0_per_frame_3=y = 0.5 + 0.18 * sin(instance * 0.785 + time * 0.05);
shape_0_per_frame_4=rad = 0.08 + 0.02 * sin(time * 0.3 + instance);
shape_0_per_frame_5=r = 0.9 + 0.1 * sin(time * 0.2 + instance * 0.5);
shape_0_per_frame_6=g = 0.7 + 0.1 * sin(time * 0.15 + instance * 0.3);
shape_0_per_frame_7=b = 0.1 + 0.1 * sin(time * 0.25 + instance * 0.7);
shape_0_per_frame_8=a = 0.7 + 0.15 * q1;
shapecode_1=enabled=1,sides=64,additive=1,thickOutline=1,textured=0,num_inst=4,x=0.5,y=0.5,rad=0.100000,ang=0.000000,r=0.500000,g=0.250000,b=0.800000,r2=0.400000,g2=0.200000,b2=0.600000,a=0.500000,a2=0.300000,border_r=0.600000,border_g=0.300000,border_b=0.900000,border_a=0.900000
shape_1_per_frame_1=rad = 0.06 + instance * 0.06;
shape_1_per_frame_2=ang = time * 0.04 * (1 + instance * 0.5);
shape_1_per_frame_3=r = 0.4 + 0.2 * sin(time * 0.1 + instance);
shape_1_per_frame_4=g = 0.15 + 0.1 * sin(time * 0.12 + instance);
shape_1_per_frame_5=b = 0.7 + 0.2 * sin(time * 0.08 + instance);
shape_1_per_frame_6=a = 0.4 + 0.2 * sin(time * 0.2);
per_frame_init_1=sb = 1; sm = 1; st = 1; be = 0; lb = 0; th = 1.4;
per_frame_init_2=phase = 0;
per_frame_1=sb = sb * 0.92 + bass * 0.08;
per_frame_2=sm = sm * 0.92 + mid * 0.08;
per_frame_3=st = st * 0.92 + treb * 0.08;
per_frame_4=vol = (bass + mid + treb) / 3;
per_frame_5=beat = above(bass, th) * above(time - lb, 0.3);
per_frame_6=lb = if(beat, time, lb);
per_frame_7=th = if(beat, bass + 0.4, th * 0.998 + 1.3 * 0.002);
per_frame_8=be = be * 0.95 + beat * 0.3;
per_frame_9=phase = phase + 0.001 + 0.0005 * sm;
per_frame_10=zoom = 1.001 + 0.003 * sb;
per_frame_11=rot = 0.003 + 0.001 * sin(time * 0.07);
per_frame_12=decay = 0.988 + 0.01 * min(1, vol * 0.4);
per_frame_13=warp = 0.05 + 0.1 * sm;
per_frame_14=wave_r = 0.8 + 0.1 * sin(phase * 6.28);
per_frame_15=wave_g = 0.65 + 0.1 * sin(phase * 6.28 + 1.5);
per_frame_16=wave_b = 0.15 + 0.1 * sin(phase * 6.28 + 4);
per_frame_17=q1 = sb; q2 = sm; q3 = st; q4 = be; q5 = phase;
per_pixel_1=zoom = zoom + 0.008 * sin(rad * 6 + time * 0.15);
per_pixel_2=rot = rot + 0.004 * sin(ang * 8 + time * 0.1) * (1 - rad);
