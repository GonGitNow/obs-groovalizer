per_frame_4=warp = 0.2 + 0.2*sin(time*0.03) + 0.15*bass_att;
per_frame_5=wave_r = 0.1 + 0.4*sin(time*0.1 + 2.0);
per_frame_6=wave_g = 0.7 + 0.3*sin(time*0.12);
