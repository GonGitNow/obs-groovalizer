per_frame_10=rot = 0.001*sin(time*0.02)*bass_att;
per_pixel_1=dy = dy + 0.002*sin(x*6.283 + time*0.2)*mid_att;
per_pixel_2=dx = dx + 0.001*cos(y*6.283 + time*0.15)*treb_att;
per_pixel_3=zoom = zoom + 0.003*sin(rad*6.283*2.0)*bass_att;
