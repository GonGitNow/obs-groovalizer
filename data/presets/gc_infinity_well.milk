per_frame_init_1=sb = 1; st = 1; sm = 1; be = 0; lb = 0; th = 1.4; depth = 0;
per_frame_1=sb = sb * 0.85 + bass * 0.15;
per_frame_2=st = st * 0.85 + treb * 0.15;
per_frame_3=sm = sm * 0.85 + mid * 0.15;
per_frame_4=vol = (bass + mid + treb) / 3;
per_frame_5=beat = above(bass, th) * above(time - lb, 0.2);
per_frame_6=lb = if(beat, time, lb);
per_frame_7=th = if(beat, bass + 0.3, th * 0.997 + 1.3 * 0.003);
per_frame_8=be = be * 0.9 + beat * 0.7;
per_frame_9=depth = depth + 0.008 + 0.004 * sb;
per_frame_10=zoom = 1.04 + 0.02 * sb + be * 0.03;
per_frame_11=rot = 0.004 + 0.006 * sin(time * 0.15);
per_frame_12=decay = 0.955 + 0.03 * min(1, vol * 0.4);
per_frame_13=warp = 0.6 + 0.4 * sm;
per_frame_14=wave_r = 0.05 + 0.1 * sin(depth * 1.5);
per_frame_15=wave_g = 0.5 + 0.2 * sin(depth * 1.5 + 1);
per_frame_16=wave_b = 0.4 + 0.2 * sin(depth * 1.5 + 2.5);
per_frame_17=wave_a = 0.25 + 0.2 * vol;
per_frame_18=ob_r = 0.0;
per_frame_19=ob_g = 0.1 + 0.1 * sin(depth);
per_frame_20=ob_b = 0.08 + 0.08 * sin(depth + 1);
per_frame_21=q1 = sb; q2 = st; q3 = depth; q4 = be; q5 = vol; q6 = sm;
per_pixel_1=zoom = zoom + 0.05 * rad * rad;
per_pixel_2=rot = rot + 0.015 * (1 - rad);
per_pixel_3=dx = 0.001 * sin(ang * 6 + time * 0.3) * rad * rad;
per_pixel_4=dy = 0.001 * cos(ang * 6 + time * 0.3) * rad * rad;
wavecode_0_enabled=1
wavecode_0_samples=512
wavecode_0_sep=0
wavecode_0_bSpectrum=0
wavecode_0_bUseDots=0
