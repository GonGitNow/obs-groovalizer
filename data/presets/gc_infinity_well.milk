shapecode_0_border_b=0.400000
shapecode_0_border_a=0.500000
shape_0_per_frame1=rad = 0.06 + instance * 0.06 + 0.015 * sin(q3 * 2.5 + instance);
shape_0_per_frame2=ang = q3 * 0.4 * (1 + instance * 0.2);
shape_0_per_frame3=border_a = 0.6 - instance * 0.08;
shape_0_per_frame4=border_r = 0.0 + 0.05 * instance;
shape_0_per_frame5=border_g = 0.4 + 0.15 * sin(q3 * 2 + instance);
shape_0_per_frame6=border_b = 0.35 + 0.15 * sin(q3 * 2 + instance + 1);
shape_0_per_frame7=a = 0; a2 = 0;
