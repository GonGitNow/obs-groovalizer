wavecode_0_r=0.100000
wavecode_0_g=0.600000
wavecode_0_b=0.500000
wavecode_0_a=0.500000
wave_0_per_point1=ring_r = 0.1 + 0.04 * sin(sample * 12.566 + q3 * 3);
wave_0_per_point2=ring_a = sample * 6.283185;
wave_0_per_point3=x = 0.5 + (ring_r + value1 * 0.03) * cos(ring_a) * aspecty;
wave_0_per_point4=y = 0.5 + (ring_r + value1 * 0.03) * sin(ring_a);
wave_0_per_point5=r = 0.05 + 0.1 * sin(sample * 6.28 + q3);
wave_0_per_point6=g = 0.5 + 0.2 * sin(sample * 6.28 + q3 + 1);
wave_0_per_point7=b = 0.4 + 0.2 * sin(sample * 6.28 + q3 + 2.5);
