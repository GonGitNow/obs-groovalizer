per_frame_init_1=sb = 1; sm = 1; st = 1; be = 0; lb = 0; th = 1.4;
per_frame_init_2=phase = 0; energy = 0; drift = 0;
per_frame_1=sb = sb * 0.80 + bass * 0.20;
per_frame_2=sm = sm * 0.85 + mid * 0.15;
per_frame_3=st = st * 0.85 + treb * 0.15;
per_frame_4=vol = (bass + mid + treb) / 3;
per_frame_5=beat = above(bass, th) * above(time - lb, 0.20);
per_frame_6=lb = if(beat, time, lb);
per_frame_7=th = if(beat, bass + 0.35, th * 0.996 + 1.35 * 0.004);
per_frame_8=be = be * 0.92 + beat * 0.6;
per_frame_9=energy = energy * 0.97 + vol * 0.03;
per_frame_10=phase = phase + 0.003 + be * 0.015;
per_frame_11=drift = 0.003 + 0.002 * sin(time * 0.15);
per_frame_12=zoom = 1.005 + 0.01 * sb;
per_frame_13=dy = -drift - 0.002 * sb;
per_frame_14=rot = 0.003 * sin(time * 0.2);
per_frame_15=warp = 1.5 + 1.0 * sm + be * 0.5;
per_frame_16=decay = 0.96 + 0.03 * min(1, vol * 0.5);
per_frame_17=wave_r = 0.8 + 0.2 * sin(phase * 6.28);
per_frame_18=wave_g = 0.3 + 0.3 * sin(phase * 6.28 + 1.0);
per_frame_19=wave_b = 0.05 + 0.1 * sin(phase * 6.28 + 2.5);
per_frame_20=ob_r = 0.5 + 0.3 * sin(phase * 3.14);
per_frame_21=ob_g = 0.15 + 0.15 * sin(phase * 3.14 + 1.0);
per_frame_22=ob_b = 0.0;
per_frame_23=q1 = sb; q2 = sm; q3 = st; q4 = be; q5 = phase; q6 = energy;
per_pixel_1=dy = dy - 0.006 * sin(ang * 4) * (1 - rad);
per_pixel_2=warp = warp + 0.8 * sin(ang * 3 + time * 0.3) * rad;
per_pixel_3=zoom = zoom + 0.03 * sin(ang * 4 + 1.0) * rad * (1 - rad);
shapecode_0_enabled=1
shapecode_0_sides=30
shapecode_0_additive=1
shapecode_0_thickOutline=0
shapecode_0_textured=0
