shapecode_0_border_g=0.400000
shapecode_0_border_b=0.050000
shapecode_0_border_a=0.200000
shape_0_per_frame_1=t1 = instance / 4;
shape_0_per_frame_2=x = 0.3 + 0.4 * t1 + 0.08 * sin(time * 0.2 + t1 * 6.28);
shape_0_per_frame_3=y = 0.7 - 0.5 * t1 + 0.1 * sin(time * 0.15 + t1 * 4.0);
shape_0_per_frame_4=rad = 0.06 + 0.04 * sin(time * 0.3 + t1 * 3.14);
shape_0_per_frame_5=r = 1.0; g = 0.4 + 0.3 * t1; b = 0.05 + 0.1 * t1;
shape_0_per_frame_6=a = 0.12 + 0.06 * sin(time * 0.25 + t1 * 6.28);
