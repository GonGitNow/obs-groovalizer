per_frame_init_1=sb = 1; st = 1; sm = 1; be = 0; lb = 0; th = 1.4; phase = 0;
per_frame_1=sb = sb * 0.85 + bass * 0.15;
per_frame_2=st = st * 0.85 + treb * 0.15;
per_frame_3=sm = sm * 0.85 + mid * 0.15;
per_frame_4=vol = (bass + mid + treb) / 3;
per_frame_5=beat = above(bass, th) * above(time - lb, 0.25);
per_frame_6=lb = if(beat, time, lb);
per_frame_7=th = if(beat, bass + 0.3, th * 0.997 + 1.3 * 0.003);
per_frame_8=be = be * 0.9 + beat * 0.6;
per_frame_9=phase = phase + 0.006 + 0.002 * sm;
per_frame_10=zoom = 1.01 + 0.008 * sb;
per_frame_11=rot = 0.003 + 0.002 * sin(time * 0.1);
per_frame_12=decay = 0.955 + 0.025 * min(1, vol * 0.4);
per_frame_13=wave_r = 0.5 + 0.3 * sin(phase * 1.5);
per_frame_14=wave_g = 0.3 + 0.3 * sin(phase * 1.5 + 2.5);
per_frame_15=wave_b = 0.8 + 0.2 * sin(phase * 1.5 + 4);
per_frame_16=wave_a = 0.5 + 0.3 * st;
per_frame_17=mv_a = 0.03 + 0.02 * sin(time * 0.2);
per_frame_18=mv_r = 0.5 + 0.3 * sin(phase);
per_frame_19=mv_g = 0.4 + 0.3 * sin(phase + 2);
per_frame_20=mv_b = 0.9 + 0.1 * sin(phase + 4);
per_frame_21=q1 = sb; q2 = st; q3 = phase; q4 = be; q5 = vol;
per_pixel_1=rot = rot + 0.08 * (1 - rad);
per_pixel_2=zoom = zoom + 0.01 * rad;
per_pixel_3=dx = 0.001 * sin(ang * 3 + time * 0.2) * rad;
per_pixel_4=dy = 0.001 * cos(ang * 3 + time * 0.2) * rad;
wavecode_0_enabled=1
wavecode_0_samples=512
wavecode_0_sep=0
wavecode_0_bSpectrum=0
wavecode_0_bUseDots=1
wavecode_0_bDrawThick=0
wavecode_0_bAdditive=1
wavecode_0_scaling=1.500000
wavecode_0_smoothing=0.400000
wavecode_0_r=0.700000
wavecode_0_g=0.500000
wavecode_0_b=1.000000
wavecode_0_a=0.800000
wave_0_per_point1=spr = 0.05 + sample * 0.4;
wave_0_per_point2=spa = sample * 18.85 + q3 * 3;
wave_0_per_point3=x = 0.5 + spr * cos(spa) * aspecty;
wave_0_per_point4=y = 0.5 + spr * sin(spa);
wave_0_per_point5=r = 0.5 + 0.4 * sin(sample * 6.28 + q3);
wave_0_per_point6=g = 0.3 + 0.4 * sin(sample * 6.28 + q3 + 2);
wave_0_per_point7=b = 0.8 + 0.2 * sin(sample * 6.28 + q3 + 4);
wave_0_per_point8=a = 0.3 + 0.5 * (1 - sample);
shapecode_0_enabled=1
