shapecode_0_border_g=0.300000
shapecode_0_border_b=1.000000
shapecode_0_border_a=0.400000
shape_0_per_frame1=rad = 0.03 + instance * 0.05 + 0.01 * sin(q3 * 2 + instance);
shape_0_per_frame2=ang = q3 * 0.3 + instance * 2.094;
shape_0_per_frame3=border_a = 0.5 - instance * 0.1;
shape_0_per_frame4=border_r = 0.4 + 0.2 * sin(q3 + instance);
shape_0_per_frame5=border_g = 0.2 + 0.2 * sin(q3 + instance + 2);
shape_0_per_frame6=border_b = 0.9 - 0.1 * instance;
shape_0_per_frame7=a = 0; a2 = 0;
