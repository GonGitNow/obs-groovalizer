per_pixel_1=dx = dx + 0.003*sin(ang*3.0 + time*0.15)*mid_att;
per_pixel_2=dy = dy + 0.003*cos(ang*3.0 + time*0.15)*mid_att;
per_pixel_3=zoom = zoom + 0.005*sin(rad*6.283 + time*0.1)*bass_att;
