per_frame_1=zoom = 1.0 + 0.008*sin(time*0.06)*mid_att;
per_frame_2=rot = 0.004*sin(time*0.03) + 0.002*bass_att;
per_frame_3=warp = 0.5 + 0.3*sin(time*0.05) + 0.2*mid_att;
