wave_1_per_point2=rad2 = 0.4 + value1 * 0.2;
wave_1_per_point3=x = 0.5 + rad2 * cos(ang2 - q6 * 0.2) * aspecty;
wave_1_per_point4=y = 0.5 + rad2 * sin(ang2 - q6 * 0.2);
wave_1_per_point5=r = 0.3 + 0.3 * sin(q3 * 6.28 + 1);
