per_frame_init_1=smooth_bass = 1; smooth_treb = 1; beat_energy = 0; hue_shift = 0;
per_frame_init_2=spiral_speed = 0; pulse = 0; last_beat = 0; threshold = 1.4;
per_frame_1=smooth_bass = smooth_bass * 0.85 + bass * 0.15;
per_frame_2=smooth_treb = smooth_treb * 0.85 + treb * 0.15;
per_frame_3=vol = (bass + mid + treb) / 3;
per_frame_4=beat = above(bass, threshold) * above(time - last_beat, 0.18);
per_frame_5=last_beat = if(beat, time, last_beat);
per_frame_6=threshold = if(beat, bass + 0.4, threshold * 0.996 + 1.3 * 0.004);
per_frame_7=beat_energy = beat_energy * 0.92 + beat * 0.6;
per_frame_8=hue_shift = hue_shift + 0.003 + beat_energy * 0.02;
per_frame_9=zoom = 1.005 + 0.015 * smooth_bass + beat_energy * 0.02;
per_frame_10=rot = 0.01 + 0.02 * sin(time * 0.3) + beat_energy * 0.03;
per_frame_11=warp = 0.4 + 0.6 * smooth_treb;
per_frame_12=decay = 0.94 + 0.04 * min(1, vol * 0.7);
per_frame_13=cx = 0.5 + 0.08 * sin(time * 0.41);
per_frame_14=cy = 0.5 + 0.08 * cos(time * 0.37);
per_frame_15=wave_r = 0.6 + 0.4 * sin(hue_shift * 6.28);
per_frame_16=wave_g = 0.6 + 0.4 * sin(hue_shift * 6.28 + 2.09);
per_frame_17=wave_b = 0.6 + 0.4 * sin(hue_shift * 6.28 + 4.19);
per_frame_18=wave_a = 0.6 + 0.3 * min(1, vol);
per_frame_19=ob_a = 0.3 + 0.4 * beat_energy;
per_frame_20=ob_r = 0.3 + 0.3 * sin(hue_shift * 6.28 + 1);
per_frame_21=ob_g = 0.1; ob_b = 0.4 + 0.3 * sin(hue_shift * 6.28 + 3);
per_frame_22=echo_alpha = 0.2 + 0.2 * beat_energy;
per_frame_23=echo_zoom = 1.01 + 0.01 * smooth_bass;
per_frame_24=q1 = smooth_bass; q2 = smooth_treb; q3 = hue_shift; q4 = beat_energy;
per_frame_25=q5 = vol; q6 = time;
per_pixel_1=zoom = zoom + 0.04 * rad * sin(ang * 6 + time * 0.5);
per_pixel_2=rot = rot + 0.05 * sin(ang * 6 + time * 0.8) * (1 - rad);
per_pixel_3=dx = 0.003 * sin(ang * 3 + time * 0.7) * rad;
per_pixel_4=dy = 0.003 * cos(ang * 3 + time * 0.7) * rad;
