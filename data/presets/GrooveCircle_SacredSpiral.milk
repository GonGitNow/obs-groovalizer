wave_0_per_point1=ang2 = sample * 6.283185 * 3;
wave_0_per_point2=rad2 = 0.25 + value1 * 0.12 + 0.03 * sin(sample * 18.85 + q6 * 2);
wave_0_per_point3=x = 0.5 + rad2 * cos(ang2 + q6 * 0.4) * aspecty;
wave_0_per_point4=y = 0.5 + rad2 * sin(ang2 + q6 * 0.4);
wave_0_per_point5=r = 0.5 + 0.5 * sin(q3 * 6.28 + sample * 12);
wave_0_per_point6=g = 0.5 + 0.5 * sin(q3 * 6.28 + sample * 12 + 2.09);
wave_0_per_point7=b = 0.5 + 0.5 * sin(q3 * 6.28 + sample * 12 + 4.19);
wave_0_per_point8=a = 0.7 + 0.3 * q4;
