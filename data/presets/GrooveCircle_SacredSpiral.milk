shape_0_per_frame1=ang = instance * 1.0472 + q6 * 0.3;
shape_0_per_frame2=rad = 0.12 + 0.06 * sin(instance * 1.2 + q6 * 0.8) + q1 * 0.04;
shape_0_per_frame3=x = 0.5 + rad * cos(ang);
shape_0_per_frame4=y = 0.5 + rad * sin(ang);
