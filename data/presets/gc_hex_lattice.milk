shapecode_0=enabled=1,sides=6,additive=1,thickOutline=1,textured=0,num_inst=7,x=0.5,y=0.5,rad=0.080000,ang=0.000000,r=0.950000,g=0.700000,b=0.200000,r2=0.800000,g2=0.500000,b2=0.100000,a=0.600000,a2=0.300000,border_r=0.950000,border_g=0.700000,border_b=0.150000,border_a=0.900000
shape_0_per_frame_1=is_center = below(instance, 0.5);
shape_0_per_frame_2=hex_ang = (instance - 1) * 1.047;
shape_0_per_frame_3=x = if(is_center, 0.5, 0.5 + 0.16 * cos(hex_ang));
shape_0_per_frame_4=y = if(is_center, 0.5, 0.5 + 0.16 * sin(hex_ang));
shape_0_per_frame_5=ang = time * 0.03;
shape_0_per_frame_6=rad = 0.08 + 0.015 * sin(time * 0.25 + instance) + 0.01 * q1;
shape_0_per_frame_7=r = 0.95 + 0.05 * sin(time * 0.15 + instance);
shape_0_per_frame_8=g = 0.65 + 0.1 * sin(time * 0.12 + instance * 0.7);
shape_0_per_frame_9=b = 0.15 + 0.1 * sin(time * 0.18 + instance * 0.5);
shape_0_per_frame_10=a = 0.5 + 0.2 * q1;
per_frame_init_1=sb = 1; sm = 1; st = 1; be = 0; lb = 0; th = 1.4;
per_frame_init_2=phase = 0;
per_frame_1=sb = sb * 0.92 + bass * 0.08;
per_frame_2=sm = sm * 0.92 + mid * 0.08;
per_frame_3=st = st * 0.92 + treb * 0.08;
per_frame_4=vol = (bass + mid + treb) / 3;
per_frame_5=beat = above(bass, th) * above(time - lb, 0.3);
per_frame_6=lb = if(beat, time, lb);
per_frame_7=th = if(beat, bass + 0.4, th * 0.998 + 1.3 * 0.002);
per_frame_8=be = be * 0.95 + beat * 0.3;
per_frame_9=phase = phase + 0.0012 + 0.0006 * sm;
per_frame_10=zoom = 1.001 + 0.004 * sb;
per_frame_11=rot = 0.001 + 0.001 * sin(time * 0.06);
per_frame_12=decay = 0.985 + 0.012 * min(1, vol * 0.4);
per_frame_13=warp = 0.1 + 0.2 * sm;
per_frame_14=wave_r = 0.95;
per_frame_15=wave_g = 0.7 + 0.1 * sin(phase * 6.28);
per_frame_16=wave_b = 0.25 + 0.1 * sin(phase * 6.28 + 2.5);
per_frame_17=q1 = sb; q2 = sm; q3 = st; q4 = be; q5 = phase;
per_pixel_1=zoom = zoom + 0.01 * sin(ang * 6 + time * 0.15) * sin(rad * 4);
per_pixel_2=rot = rot + 0.005 * sin(ang * 6 + time * 0.1) * (1 - rad);
per_pixel_3=warp = warp + 0.15 * sin(ang * 6 + rad * 3);
