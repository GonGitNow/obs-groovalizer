per_frame_9=dy = 0.005*cos(time*0.18)*bass_att;
per_frame_10=fVideoEchoZoom = 1.01 + 0.02*bass_att;
per_pixel_1=zoom = zoom + 0.04*bass_att*(1.0 - rad);
per_pixel_2=rot = rot + 0.02*sin(ang*2.0)*bass_att;
