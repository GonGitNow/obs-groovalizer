per_frame_1=zoom = 1.0 + 0.06*bass - 0.02*mid;
per_frame_2=rot = 0.01*sin(time*0.08)*treb_att;
per_frame_3=warp = 0.5 + 0.8*bass_att;
per_frame_4=fDecay = 0.93 + 0.04*bass_att;
per_frame_5=wave_r = 0.9 + 0.1*bass_att;
