b1ed=0.250000
per_frame_init_1=sb = 1; sm = 1; st = 1; be = 0; lb = 0; th = 1.4;
per_frame_init_2=phase = 0;
per_frame_1=sb = sb * 0.93 + bass * 0.07;
per_frame_2=sm = sm * 0.93 + mid * 0.07;
per_frame_3=st = st * 0.93 + treb * 0.07;
per_frame_4=vol = (bass + mid + treb) / 3;
per_frame_5=beat = above(bass, th) * above(time - lb, 0.3);
per_frame_6=lb = if(beat, time, lb);
per_frame_7=th = if(beat, bass + 0.4, th * 0.998 + 1.3 * 0.002);
per_frame_8=be = be * 0.95 + beat * 0.3;
per_frame_9=phase = phase + 0.001 + 0.0005 * sm;
per_frame_10=zoom = 0.997 + 0.003 * sb;
per_frame_11=rot = 0.004 + 0.002 * sin(time * 0.07);
per_frame_12=decay = 0.991 + 0.007 * min(1, vol * 0.4);
per_frame_13=warp = 0.05 + 0.08 * sm;
per_frame_14=wave_r = 0.3 + 0.3 * sin(phase * 6.28 + 4);
per_frame_15=wave_g = 0.3 + 0.3 * sin(phase * 6.28 + 4.5);
per_frame_16=wave_b = 0.7 + 0.3 * sin(phase * 6.28);
per_frame_17=q1 = sb; q2 = sm; q3 = st; q4 = be; q5 = phase;
per_pixel_1=zoom = zoom - 0.005 * (1 - rad);
per_pixel_2=rot = rot + 0.05 * (1 - rad) + 0.01 * sin(ang * 3 + time * 0.1);
per_pixel_3=warp = warp + 0.08 * sin(rad * 6.28 + time * 0.2);
