shape_0_per_frame1=pulse = sin(q5 * 0.5) * 0.5 + 0.5;
shape_0_per_frame2=rad = 0.05 + 0.10 * pulse + q3 * 0.08;
shape_0_per_frame3=a = 0.3 + 0.4 * pulse;
shape_0_per_frame4=a2 = 0.1 + 0.2 * pulse;
shape_0_per_frame5=border_a = 0.6 + 0.4 * pulse;
shape_0_per_frame6=border_r = 0.8 + 0.2 * q3; border_g = 0.9; border_b = 1.0;
