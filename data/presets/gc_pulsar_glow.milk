per_frame_init_1=smooth_bass = 1; smooth_treb = 1; beat_energy = 0; last_beat = 0; threshold = 1.4;
per_frame_1=smooth_bass = smooth_bass * 0.85 + bass * 0.15;
per_frame_2=smooth_treb = smooth_treb * 0.85 + treb * 0.15;
per_frame_3=vol = (bass + mid + treb) / 3;
per_frame_4=beat = above(bass, threshold) * above(time - last_beat, 0.2);
per_frame_5=last_beat = if(beat, time, last_beat);
per_frame_6=threshold = if(beat, bass + 0.4, threshold * 0.996 + 1.3 * 0.004);
per_frame_7=beat_energy = beat_energy * 0.90 + beat * 0.6;
per_frame_8=zoom = 1.001 + 0.003 * smooth_bass;
per_frame_9=rot = 0.001 * sin(time * 0.1);
per_frame_10=decay = 0.975 + 0.015 * min(1, vol * 0.5);
per_frame_11=wave_r = 0.7 + 0.3 * beat_energy;
per_frame_12=wave_g = 0.8 + 0.2 * beat_energy;
per_frame_13=wave_b = 1.0;
per_frame_14=wave_a = 0.3 + 0.2 * vol;
per_frame_15=q1 = smooth_bass; q2 = smooth_treb; q3 = beat_energy; q4 = vol; q5 = time;
per_frame_16=q6 = sin(time * 0.5) * 0.5 + 0.5;
per_pixel_1=zoom = zoom + 0.002 * sin(rad * 6.28 * 3 + time * 0.3);
per_pixel_2=dx = 0.001 * sin(ang * 2 + time * 0.2) * (1 - rad);
per_pixel_3=dy = 0.001 * cos(ang * 2 + time * 0.2) * (1 - rad);
