shape_1_per_frame1=phase = q5 * 0.3 + instance * 1.5;
shape_1_per_frame2=expand = sin(phase) * 0.5 + 0.5;
shape_1_per_frame3=rad = 0.08 + instance * 0.06 + 0.04 * expand;
shape_1_per_frame4=a = 0; a2 = 0;
shape_1_per_frame5=border_a = 0.2 + 0.2 * (1 - expand) + q3 * 0.3;
shape_1_per_frame6=border_r = 0.4 + 0.2 * expand; border_g = 0.6 + 0.2 * expand; border_b = 1.0;
