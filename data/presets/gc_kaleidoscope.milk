per_frame_init_1=sb = 1; st = 1; sm = 1; be = 0; lb = 0; th = 1.4; phase = 0;
per_frame_1=sb = sb * 0.85 + bass * 0.15;
per_frame_2=st = st * 0.85 + treb * 0.15;
per_frame_3=sm = sm * 0.85 + mid * 0.15;
per_frame_4=vol = (bass + mid + treb) / 3;
per_frame_5=beat = above(bass, th) * above(time - lb, 0.25);
per_frame_6=lb = if(beat, time, lb);
per_frame_7=th = if(beat, bass + 0.3, th * 0.997 + 1.3 * 0.003);
per_frame_8=be = be * 0.9 + beat * 0.7;
per_frame_9=phase = phase + 0.008 + 0.003 * sm;
per_frame_10=zoom = 1.005 + 0.01 * sb;
per_frame_11=rot = 0.002 + 0.003 * sin(time * 0.15);
per_frame_12=decay = 0.975 + 0.02 * min(1, vol * 0.4);
per_frame_13=warp = 0.5 + 0.5 * st;
per_frame_14=wave_r = 0.7 + 0.3 * sin(phase * 2);
per_frame_15=wave_g = 0.3 + 0.3 * sin(phase * 2 + 2.1);
per_frame_16=wave_b = 0.2 + 0.4 * sin(phase * 2 + 4.2);
per_frame_17=wave_a = 0.3 + 0.2 * vol;
per_frame_18=ob_r = 0.3 + 0.2 * sin(phase);
per_frame_19=ob_g = 0.1 + 0.2 * sin(phase + 2);
per_frame_20=ob_b = 0.1 + 0.3 * sin(phase + 4);
per_frame_21=q1 = sb; q2 = st; q3 = phase; q4 = be; q5 = vol; q6 = sm;
per_pixel_1=zoom = zoom + 0.03 * sin(ang * 8) * rad;
per_pixel_2=rot = rot + 0.015 * sin(ang * 8 + 1.57) * rad;
per_pixel_3=dx = 0.002 * sin(ang * 8 + time * 0.3) * rad * rad;
per_pixel_4=dy = 0.002 * cos(ang * 8 + time * 0.3) * rad * rad;
wavecode_0_enabled=1
wavecode_0_samples=512
wavecode_0_sep=0
wavecode_0_bSpectrum=0
wavecode_0_bUseDots=0
wavecode_0_bDrawThick=1
wavecode_0_bAdditive=1
wavecode_0_scaling=1.000000
wavecode_0_smoothing=0.600000
wavecode_0_r=0.800000
wavecode_0_g=0.400000
wavecode_0_b=0.200000
wavecode_0_a=0.600000
wave_0_per_point1=ring_r = 0.12 + 0.04 * sin(sample * 12.566 + q3 * 3);
wave_0_per_point2=ring_a = sample * 6.283185;
wave_0_per_point3=x = 0.5 + (ring_r + value1 * 0.03) * cos(ring_a) * aspecty;
wave_0_per_point4=y = 0.5 + (ring_r + value1 * 0.03) * sin(ring_a);
wave_0_per_point5=r = 0.8 + 0.2 * sin(sample * 6.28 + q3 * 2);
wave_0_per_point6=g = 0.3 + 0.3 * sin(sample * 6.28 + q3 * 2 + 2);
wave_0_per_point7=b = 0.1 + 0.3 * sin(sample * 6.28 + q3 * 2 + 4);
