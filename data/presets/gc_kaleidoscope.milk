shapecode_0_border_g=0.400000
shapecode_0_border_b=0.200000
shapecode_0_border_a=0.600000
shape_0_per_frame1=rad = 0.05 + instance * 0.04 + 0.015 * sin(q3 * 2 + instance);
shape_0_per_frame2=ang = q3 * 0.8 + instance * 0.785;
shape_0_per_frame3=sides = 8;
shape_0_per_frame4=border_a = 0.7 - instance * 0.12;
shape_0_per_frame5=border_r = 0.8 - 0.15 * instance + 0.2 * sin(q3 + instance);
shape_0_per_frame6=border_g = 0.3 + 0.2 * sin(q3 * 1.5 + instance);
shape_0_per_frame7=border_b = 0.1 + 0.3 * sin(q3 * 2 + instance * 2);
shape_0_per_frame8=a = 0; a2 = 0;
