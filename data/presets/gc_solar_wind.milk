per_frame_init_1=smooth_bass = 1; smooth_treb = 1; beat_energy = 0; last_beat = 0; threshold = 1.4;
per_frame_1=smooth_bass = smooth_bass * 0.85 + bass * 0.15;
per_frame_2=smooth_treb = smooth_treb * 0.85 + treb * 0.15;
per_frame_3=vol = (bass + mid + treb) / 3;
per_frame_4=beat = above(bass, threshold) * above(time - last_beat, 0.2);
per_frame_5=last_beat = if(beat, time, last_beat);
per_frame_6=threshold = if(beat, bass + 0.4, threshold * 0.996 + 1.3 * 0.004);
per_frame_7=beat_energy = beat_energy * 0.92 + beat * 0.5;
per_frame_8=zoom = 1.02 + 0.01 * smooth_bass;
per_frame_9=rot = 0.001 * sin(time * 0.1);
per_frame_10=decay = 0.955 + 0.02 * min(1, vol * 0.5);
per_frame_11=mv_a = 0.2 + 0.15 * smooth_bass;
per_frame_12=mv_r = 0.9 + 0.1 * sin(time * 0.2);
per_frame_13=mv_g = 0.5 + 0.2 * sin(time * 0.2 + 1.0);
per_frame_14=mv_b = 0.15 + 0.15 * sin(time * 0.2 + 2.5);
per_frame_15=ob_r = 0.1 + 0.1 * sin(time * 0.15);
per_frame_16=ob_g = 0.05 + 0.1 * sin(time * 0.15 + 1.5);
per_frame_17=ob_b = 0.4 + 0.2 * sin(time * 0.15 + 3.0);
per_frame_18=ob_a = 0.5 + 0.2 * smooth_treb;
per_frame_19=q1 = smooth_bass; q2 = smooth_treb; q3 = beat_energy; q4 = vol; q5 = time;
per_frame_20=wave_a = 0.3 + 0.2 * vol;
per_pixel_1=push = 0.005 + 0.003 * q1;
per_pixel_2=dx = push * cos(ang) * (0.5 + 0.5 * rad);
per_pixel_3=dy = push * sin(ang) * (0.5 + 0.5 * rad);
per_pixel_4=zoom = zoom - 0.02 * (1 - rad);
