wavecode_0_b=1.000000
wavecode_0_a=0.800000
wave_0_per_point1=ang2 = sample * 6.283185 * 2;
wave_0_per_point2=rad2 = 0.15 + value1 * 0.1 + 0.02 * sin(sample * 12.57 + q6 * 1.5);
wave_0_per_point3=x = 0.5 + rad2 * cos(ang2 + q6 * 0.6) * aspecty;
wave_0_per_point4=y = 0.5 + rad2 * sin(ang2 + q6 * 0.6);
wave_0_per_point5=r = 0.5 + 0.5 * sin(q3 * 6.28 + sample * 8);
wave_0_per_point6=g = 0.5 + 0.5 * sin(q3 * 6.28 + sample * 8 + 2.09);
wave_0_per_point7=b = 0.5 + 0.5 * sin(q3 * 6.28 + sample * 8 + 4.19);
