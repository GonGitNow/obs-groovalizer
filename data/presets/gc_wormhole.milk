per_frame_init_1=smooth_bass = 1; smooth_treb = 1; beat_energy = 0; hue = 0; last_beat = 0; threshold = 1.4;
per_frame_1=smooth_bass = smooth_bass * 0.85 + bass * 0.15;
per_frame_2=smooth_treb = smooth_treb * 0.85 + treb * 0.15;
per_frame_3=vol = (bass + mid + treb) / 3;
per_frame_4=beat = above(bass, threshold) * above(time - last_beat, 0.2);
per_frame_5=last_beat = if(beat, time, last_beat);
per_frame_6=threshold = if(beat, bass + 0.4, threshold * 0.996 + 1.3 * 0.004);
per_frame_7=beat_energy = beat_energy * 0.92 + beat * 0.5;
per_frame_8=hue = hue + 0.015 + beat_energy * 0.04;
per_frame_9=zoom = 1.03 + 0.008 * smooth_bass;
per_frame_10=rot = 0.008 + 0.005 * sin(time * 0.2) + beat_energy * 0.01;
per_frame_11=decay = 0.96 + 0.02 * min(1, vol * 0.5);
per_frame_12=warp = 0.5 + 0.4 * smooth_treb;
per_frame_13=wave_r = 0.5 + 0.5 * sin(hue * 6.28);
per_frame_14=wave_g = 0.5 + 0.5 * sin(hue * 6.28 + 2.09);
per_frame_15=wave_b = 0.5 + 0.5 * sin(hue * 6.28 + 4.19);
per_frame_16=wave_a = 0.5 + 0.3 * vol;
per_frame_17=ob_r = 0.3 + 0.3 * sin(hue * 6.28 + 1.0);
per_frame_18=ob_g = 0.2 + 0.2 * sin(hue * 6.28 + 3.0);
per_frame_19=ob_b = 0.5 + 0.3 * sin(hue * 6.28 + 5.0);
per_frame_20=q1 = smooth_bass; q2 = smooth_treb; q3 = hue; q4 = beat_energy; q5 = vol; q6 = time;
per_pixel_1=rot = rot + 0.1 * (1 - rad);
per_pixel_2=zoom = zoom + 0.02 * rad;
per_pixel_3=dx = 0.002 * sin(ang * 4 + time * 0.5) * rad;
per_pixel_4=dy = 0.002 * cos(ang * 4 + time * 0.5) * rad;
wavecode_0_enabled=1
wavecode_0_samples=256
wavecode_0_sep=0
wavecode_0_bSpectrum=0
