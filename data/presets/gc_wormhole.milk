shape_0_per_frame1=ang = instance * 1.5708 + q6 * 0.5;
shape_0_per_frame2=rad = 0.08 + instance * 0.04 + 0.02 * sin(q6 * 0.7 + instance);
shape_0_per_frame3=x = 0.5; y = 0.5;
shape_0_per_frame4=border_r = 0.5 + 0.5 * sin(q3 * 6.28 + instance * 1.57);
shape_0_per_frame5=border_g = 0.5 + 0.5 * sin(q3 * 6.28 + instance * 1.57 + 2.09);
shape_0_per_frame6=border_b = 0.5 + 0.5 * sin(q3 * 6.28 + instance * 1.57 + 4.19);
shape_0_per_frame7=border_a = 0.3 + 0.3 * q4;
shape_0_per_frame8=a = 0; a2 = 0;
