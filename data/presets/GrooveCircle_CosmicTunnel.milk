shapecode_0_border_r=0.200000
shapecode_0_border_g=0.500000
shapecode_0_border_b=1.000000
shapecode_0_border_a=0.500000
shape_0_per_frame1=rad = 0.08 + instance * 0.07 + 0.02 * sin(q3 * 3 + instance);
shape_0_per_frame2=ang = q3 * 0.5 * (1 + instance * 0.3);
shape_0_per_frame3=border_a = 0.6 - instance * 0.1;
shape_0_per_frame4=border_r = 0.1 + 0.1 * instance;
shape_0_per_frame5=border_g = 0.3 + 0.15 * sin(q3 * 2 + instance);
shape_0_per_frame6=border_b = 0.9 - 0.1 * instance;
shape_0_per_frame7=a = 0; a2 = 0;
