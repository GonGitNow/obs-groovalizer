per_frame_init_1=sb = 1; st = 1; be = 0; lb = 0; th = 1.4; depth = 0;
per_frame_1=sb = sb * 0.8 + bass * 0.2;
per_frame_2=st = st * 0.8 + treb * 0.2;
per_frame_3=vol = (bass + mid + treb) / 3;
per_frame_4=beat = above(bass, th) * above(time - lb, 0.2);
per_frame_5=lb = if(beat, time, lb);
per_frame_6=th = if(beat, bass + 0.3, th * 0.997 + 1.3 * 0.003);
per_frame_7=be = be * 0.9 + beat * 0.8;
per_frame_8=depth = depth + 0.01 + 0.005 * sb;
per_frame_9=zoom = 1.04 + 0.03 * sb + be * 0.04;
per_frame_10=rot = 0.005 + 0.01 * sin(time * 0.2);
per_frame_11=warp = 1.0 + 0.8 * st;
per_frame_12=decay = 0.96 + 0.03 * min(1, vol * 0.5);
per_frame_13=echo_alpha = 0.35 + 0.15 * be;
per_frame_14=echo_zoom = 0.985;
per_frame_15=echo_orient = if(above(sin(time * 0.1), 0), 3, 0);
per_frame_16=wave_r = 0.2 + 0.3 * sin(depth * 2);
per_frame_17=wave_g = 0.5 + 0.3 * sin(depth * 2 + 2);
per_frame_18=wave_b = 0.8 + 0.2 * sin(depth * 2 + 4);
per_frame_19=wave_a = 0.4 + 0.3 * vol;
per_frame_20=ob_r = 0.05 * sin(depth * 3); ob_g = 0.1 + 0.1 * sin(depth * 3 + 1);
per_frame_21=ob_b = 0.3 + 0.2 * sin(depth * 3 + 2);
per_frame_22=q1 = sb; q2 = st; q3 = depth; q4 = be; q5 = vol;
per_pixel_1=zoom = zoom + 0.08 * rad * rad;
per_pixel_2=rot = rot + 0.02 * (1 - rad);
per_pixel_3=dx = 0.001 * sin(ang * 8 + time) * rad * rad;
per_pixel_4=dy = 0.001 * cos(ang * 8 + time) * rad * rad;
wavecode_0_enabled=1
wavecode_0_samples=512
wavecode_0_sep=0
wavecode_0_bSpectrum=0
wavecode_0_bUseDots=0
wavecode_0_bDrawThick=1
wavecode_0_bAdditive=1
wavecode_0_scaling=1.000000
wavecode_0_smoothing=0.600000
wavecode_0_r=0.200000
wavecode_0_g=0.600000
wavecode_0_b=1.000000
wavecode_0_a=0.700000
wave_0_per_point1=ring_r = 0.15 + 0.05 * sin(sample * 12.566 + q3 * 4);
wave_0_per_point2=ring_a = sample * 6.283185;
wave_0_per_point3=x = 0.5 + (ring_r + value1 * 0.04) * cos(ring_a) * aspecty;
wave_0_per_point4=y = 0.5 + (ring_r + value1 * 0.04) * sin(ring_a);
wave_0_per_point5=r = 0.1 + 0.2 * sin(sample * 6.28 + q3 * 2);
wave_0_per_point6=g = 0.4 + 0.3 * sin(sample * 6.28 + q3 * 2 + 2);
wave_0_per_point7=b = 0.8 + 0.2 * sin(sample * 6.28 + q3 * 2 + 4);
shapecode_0_enabled=1
shapecode_0_sides=64
shapecode_0_additive=1
shapecode_0_thickOutline=1
shapecode_0_textured=0
