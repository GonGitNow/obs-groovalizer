per_frame_1=zoom = 1.0 + 0.015*sin(time*0.08)*bass_att;
per_frame_2=rot = 0.003*sin(time*0.04);
per_frame_3=warp = 0.2 + 0.3*sin(time*0.06);
per_frame_4=wave_r = 0.2 + 0.3*sin(time*0.15);
per_frame_5=wave_g = 0.6 + 0.3*sin(time*0.2 + 1.5);
per_frame_6=wave_b = 0.8 + 0.2*cos(time*0.18);
per_frame_7=fDecay = 0.988 + 0.008*sin(time*0.03);
per_frame_8=dx = 0.001*sin(time*0.1)*mid_att;
per_frame_9=dy = 0.001*cos(time*0.09)*mid_att;
per_frame_10=fVideoEchoAlpha = 0.3 + 0.2*sin(time*0.05);
per_pixel_1=zoom = zoom + 0.008*sin(rad*3.14*2.0 + time*0.15)*bass_att;
per_pixel_2=dx = dx + 0.002*cos(ang*4.0 + time*0.1)*mid_att;
per_pixel_3=dy = dy + 0.002*sin(ang*4.0 + time*0.1)*mid_att;
