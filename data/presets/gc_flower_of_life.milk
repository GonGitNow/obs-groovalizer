per_frame_1=rot = 0.005 + 0.003*sin(time*0.03)*bass_att;
per_frame_2=zoom = 1.0 + 0.003*sin(time*0.05);
per_frame_3=warp = 1.2 + 0.5*sin(time*0.04) + 0.3*mid_att;
per_frame_4=wave_r = 0.6 + 0.4*sin(time*0.12 + 0.0);
per_frame_5=wave_g = 0.4 + 0.4*sin(time*0.12 + 2.094);
per_frame_6=wave_b = 0.8 + 0.2*sin(time*0.12 + 4.189);
per_frame_7=fVideoEchoAlpha = 0.4 + 0.2*sin(time*0.06);
per_frame_8=cx = 0.5 + 0.01*sin(time*0.04);
per_frame_9=cy = 0.5 + 0.01*cos(time*0.05);
per_pixel_1=dx = 0.003*sin(ang*6.0 + time*0.2)*mid_att;
per_pixel_2=dy = 0.003*cos(ang*6.0 + time*0.2)*mid_att;
per_pixel_3=zoom = zoom + 0.005*sin(rad*6.283*3.0)*bass_att;
per_pixel_4=rot = rot + 0.003*cos(rad*6.283*2.0 + time*0.1);
