per_frame_init_1=sb = 1; sm = 1; st = 1; be = 0; lb = 0; th = 1.4;
per_frame_init_2=phase = 0; gold_pulse = 0; serpent_pos = 0;
per_frame_1=sb = sb * 0.82 + bass * 0.18;
per_frame_2=sm = sm * 0.85 + mid * 0.15;
per_frame_3=st = st * 0.85 + treb * 0.15;
per_frame_4=vol = (bass + mid + treb) / 3;
per_frame_5=beat = above(bass, th) * above(time - lb, 0.2);
per_frame_6=lb = if(beat, time, lb);
per_frame_7=th = if(beat, bass + 0.35, th * 0.997 + 1.35 * 0.003);
per_frame_8=be = be * 0.9 + beat * 0.6;
per_frame_9=phase = phase + 0.003 + 0.002 * sm;
per_frame_10=gold_pulse = gold_pulse * 0.92 + be * 0.5;
per_frame_11=serpent_pos = serpent_pos + 0.008 + 0.004 * sb;
per_frame_12=zoom = 1.003 + 0.008 * sb + be * 0.01;
per_frame_13=rot = 0.003 + 0.005 * sin(time * 0.15) + be * 0.008;
per_frame_14=warp = 0.4 + 0.5 * sm;
per_frame_15=decay = 0.965 + 0.025 * min(1, vol * 0.5);
per_frame_16=wave_r = 0.9 + 0.1 * gold_pulse;
per_frame_17=wave_g = 0.7 + 0.2 * sin(phase * 4);
per_frame_18=wave_b = 0.2 + 0.15 * gold_pulse;
per_frame_19=wave_a = 0.7 + 0.3 * vol;
per_frame_20=ob_r = 0.5 + 0.3 * sin(phase * 3);
per_frame_21=ob_g = 0.3 + 0.2 * sin(phase * 3 + 1);
per_frame_22=ob_b = 0.05 + 0.1 * gold_pulse;
per_frame_23=ob_a = 0.4 + 0.3 * be;
per_frame_24=echo_alpha = 0.3 + 0.1 * be;
per_frame_25=echo_zoom = 1.006;
per_frame_26=q1 = sb; q2 = sm; q3 = st; q4 = be; q5 = phase; q6 = serpent_pos;
per_frame_27=q7 = gold_pulse; q8 = vol;
per_pixel_1=zoom = zoom + 0.015 * sin(ang * 3 + time * 0.2) * rad;
per_pixel_2=rot = rot + 0.008 * sin(ang * 2 + time * 0.3) * (1 - rad);
per_pixel_3=dx = 0.002 * sin(ang * 5 + time * 0.4) * rad * rad;
per_pixel_4=dy = 0.002 * cos(ang * 5 + time * 0.4) * rad * rad;
wavecode_0_enabled=1
wavecode_0_samples=512
wavecode_0_sep=0
wavecode_0_bSpectrum=0
wavecode_0_bUseDots=0
