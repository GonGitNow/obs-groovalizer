wavecode_0_r=1.000000
wavecode_0_g=0.500000
wavecode_0_b=0.200000
wavecode_0_a=0.900000
wave_0_per_point1=t = sample * 6.283185 * 2.5;
wave_0_per_point2=spine_x = sin(t + q6 * 3) * 0.25 * (1 - sample * 0.6);
wave_0_per_point3=spine_y = cos(t * 0.7 + q6 * 2) * 0.2 * (1 - sample * 0.5);
wave_0_per_point4=wiggle = sin(t * 8 + q6 * 12) * 0.02 * (1 - sample);
wave_0_per_point5=body_w = (0.04 + value1 * 0.02) * (1 - sample * 0.7);
wave_0_per_point6=x = 0.5 + (spine_x + wiggle) * aspecty + cos(t) * body_w;
wave_0_per_point7=y = 0.5 + spine_y + sin(t) * body_w * 0.5;
wave_0_per_point8=hue = sample * 3 + q5 * 6.28;
wave_0_per_point9=r = 0.5 + 0.5 * sin(hue);
wave_0_per_point10=g = 0.5 + 0.5 * sin(hue + 2.09);
wave_0_per_point11=b = 0.5 + 0.5 * sin(hue + 4.19);
wave_0_per_point12=gold_mix = sample * sample;
wave_0_per_point13=r = r * (1 - gold_mix) + 1.0 * gold_mix;
wave_0_per_point14=g = g * (1 - gold_mix) + 0.85 * gold_mix;
wave_0_per_point15=b = b * (1 - gold_mix) + 0.3 * gold_mix;
wave_0_per_point16=a = 0.6 + 0.4 * (1 - sample * 0.5);
wavecode_1_enabled=1
wavecode_1_samples=256
