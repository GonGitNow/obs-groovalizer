wavecode_1_g=0.900000
wavecode_1_b=0.400000
wavecode_1_a=0.700000
wave_1_per_point1=t = sample * 6.283185 * 2;
wave_1_per_point2=trail_x = sin(t + q6 * 3 - 0.5) * 0.28 * (1 - sample * 0.5);
wave_1_per_point3=trail_y = cos(t * 0.7 + q6 * 2 - 0.3) * 0.22 * (1 - sample * 0.4);
wave_1_per_point4=scatter = 0.03 * (1 - sample);
wave_1_per_point5=x = 0.5 + trail_x * aspecty + sin(sample * 100 + q6 * 20) * scatter;
wave_1_per_point6=y = 0.5 + trail_y + cos(sample * 100 + q6 * 20) * scatter;
wave_1_per_point7=hue = sample * 4 + q5 * 6.28 + 1;
wave_1_per_point8=r = 0.5 + 0.5 * sin(hue);
wave_1_per_point9=g = 0.5 + 0.5 * sin(hue + 2.09);
wave_1_per_point10=b = 0.5 + 0.5 * sin(hue + 4.19);
wave_1_per_point11=a = 0.3 + 0.4 * (1 - sample);
