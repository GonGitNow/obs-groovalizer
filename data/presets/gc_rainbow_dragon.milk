shape_0_per_frame1=rad = 0.06 + instance * 0.05 + 0.04 * q7 + 0.02 * sin(q5 * 4 + instance);
shape_0_per_frame2=ang = q5 * 0.2 * (instance + 1);
shape_0_per_frame3=a = 0.15 + 0.15 * q7 - instance * 0.04;
shape_0_per_frame4=a2 = 0.08 + 0.08 * q7;
shape_0_per_frame5=border_a = 0.3 + 0.3 * q7;
shape_0_per_frame6=border_r = 1.0;
shape_0_per_frame7=border_g = 0.8 + 0.1 * sin(q5 * 3 + instance);
shape_0_per_frame8=border_b = 0.3 + 0.1 * sin(q5 * 5 + instance);
