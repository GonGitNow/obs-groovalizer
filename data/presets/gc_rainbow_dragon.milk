shape_1_per_frame1=seed = instance * 5.17 + 2.71;
shape_1_per_frame2=orbit_r = 0.08 + 0.06 * sin(seed * 1.3);
shape_1_per_frame3=orbit_a = q5 * 0.5 + instance * 0.524 + sin(q6 * 2 + seed) * 0.3;
shape_1_per_frame4=x = 0.5 + orbit_r * cos(orbit_a);
shape_1_per_frame5=y = 0.5 + orbit_r * sin(orbit_a);
shape_1_per_frame6=rad = 0.008 + 0.012 * sin(q5 * 8 + instance * 1.5);
shape_1_per_frame7=ang = q6 * 2 + instance * 0.5;
shape_1_per_frame8=sparkle = 0.5 + 0.5 * sin(q5 * 12 + instance * 3.7);
shape_1_per_frame9=border_a = 0.3 + 0.5 * sparkle * (0.5 + 0.5 * q7);
shape_1_per_frame10=a = 0; a2 = 0;
