per_frame_init_1=sb = 1; st = 1; sm = 1; be = 0; lb = 0; th = 1.4; phase = 0;
per_frame_1=sb = sb * 0.88 + bass * 0.12;
per_frame_2=st = st * 0.88 + treb * 0.12;
per_frame_3=sm = sm * 0.88 + mid * 0.12;
per_frame_4=vol = (bass + mid + treb) / 3;
per_frame_5=beat = above(bass, th) * above(time - lb, 0.25);
per_frame_6=lb = if(beat, time, lb);
per_frame_7=th = if(beat, bass + 0.3, th * 0.997 + 1.3 * 0.003);
per_frame_8=be = be * 0.92 + beat * 0.5;
per_frame_9=phase = phase + 0.005 + 0.002 * sm;
per_frame_10=zoom = 0.98 + 0.005 * sin(time * 0.15);
per_frame_11=rot = 0.002 + 0.003 * sin(time * 0.12) + 0.002 * be;
per_frame_12=decay = 0.965 + 0.025 * min(1, vol * 0.3);
per_frame_13=echo_zoom = 0.975 + 0.005 * sin(time * 0.2);
per_frame_14=echo_alpha = 0.55 + 0.1 * sin(time * 0.15) + 0.05 * be;
per_frame_15=echo_orient = 3;
per_frame_16=wave_r = 0.2 + 0.2 * sin(phase * 1.5);
per_frame_17=wave_g = 0.1 + 0.2 * sin(phase * 1.5 + 2.5);
per_frame_18=wave_b = 0.6 + 0.3 * sin(phase * 1.5 + 4);
per_frame_19=wave_a = 0.15 + 0.1 * vol;
per_frame_20=ob_r = 0.05 + 0.1 * sin(phase);
per_frame_21=ob_g = 0.02 + 0.05 * sin(phase + 2);
per_frame_22=ob_b = 0.2 + 0.2 * sin(phase + 4);
per_frame_23=q1 = sb; q2 = st; q3 = phase; q4 = be; q5 = vol;
per_pixel_1=zoom = zoom + 0.005 * rad;
per_pixel_2=rot = rot + 0.003 * (1 - rad);
wavecode_0_enabled=1
wavecode_0_samples=256
wavecode_0_sep=0
wavecode_0_bSpectrum=0
wavecode_0_bUseDots=0
wavecode_0_bDrawThick=1
wavecode_0_bAdditive=1
wavecode_0_scaling=0.800000
wavecode_0_smoothing=0.700000
wavecode_0_r=0.200000
wavecode_0_g=0.100000
wavecode_0_b=0.600000
wavecode_0_a=0.300000
wave_0_per_point1=x = 0.5 + (sample - 0.5) * 0.6;
wave_0_per_point2=y = 0.5 + value1 * 0.08;
wave_0_per_point3=r = 0.15 + 0.15 * sin(sample * 6.28 + q3);
wave_0_per_point4=g = 0.08 + 0.1 * sin(sample * 6.28 + q3 + 2);
wave_0_per_point5=b = 0.5 + 0.3 * sin(sample * 6.28 + q3 + 4);
wave_0_per_point6=a = 0.2 + 0.15 * q5;
