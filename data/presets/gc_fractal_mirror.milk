shape_0_per_frame1=rad = 0.03 + instance * 0.04;
shape_0_per_frame2=ang = q3 * 0.4 + instance * 0.524;
shape_0_per_frame3=border_a = 0.5 - instance * 0.07;
shape_0_per_frame4=border_r = 0.15 + 0.1 * sin(q3 + instance);
shape_0_per_frame5=border_g = 0.05 + 0.1 * sin(q3 + instance + 2);
shape_0_per_frame6=border_b = 0.6 + 0.2 * sin(q3 + instance + 4);
shape_0_per_frame7=a = 0; a2 = 0;
