per_frame_1=rot = 0.002 + 0.001*sin(time*0.02);
per_frame_2=zoom = 1.0 + 0.002*sin(time*0.03);
per_frame_3=warp = 0.15 + 0.1*sin(time*0.025) + 0.05*mid_att;
per_frame_4=dy = 0.001 + 0.0005*sin(time*0.04);
per_frame_5=wave_r = 0.4 + 0.3*sin(time*0.08);
per_frame_6=wave_g = 0.25 + 0.25*sin(time*0.1 + 1.5);
per_frame_7=wave_b = 0.7 + 0.3*cos(time*0.09);
per_frame_8=fDecay = 0.994 + 0.003*sin(time*0.02);
per_frame_9=fVideoEchoAlpha = 0.65 + 0.1*sin(time*0.03);
per_frame_10=ob_a = 0.3 + 0.15*sin(time*0.04);
per_pixel_1=dx = 0.001*sin(ang*2.0 + time*0.1)*mid_att;
per_pixel_2=dy = dy + 0.001*cos(ang*2.0 + time*0.08)*mid_att;
per_pixel_3=zoom = zoom + 0.002*sin(rad*3.14)*bass_att;
