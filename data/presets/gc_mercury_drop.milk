per_frame_init_1=sb = 1; sm = 1; st = 1; be = 0; lb = 0; th = 1.4;
per_frame_init_2=phase = 0; energy = 0; flash = 0;
per_frame_1=sb = sb * 0.82 + bass * 0.18;
per_frame_2=sm = sm * 0.85 + mid * 0.15;
per_frame_3=st = st * 0.85 + treb * 0.15;
per_frame_4=vol = (bass + mid + treb) / 3;
per_frame_5=beat = above(bass, th) * above(time - lb, 0.20);
per_frame_6=lb = if(beat, time, lb);
per_frame_7=th = if(beat, bass + 0.35, th * 0.996 + 1.35 * 0.004);
per_frame_8=be = be * 0.88 + beat * 0.7;
per_frame_9=energy = energy * 0.97 + vol * 0.03;
per_frame_10=phase = phase + 0.003 + be * 0.015;
per_frame_11=flash = flash * 0.85 + beat * 0.8;
per_frame_12=zoom = 1.003 + 0.005 * sin(time * 0.25) + 0.008 * sb;
per_frame_13=rot = 0.001 * sin(time * 0.12);
per_frame_14=warp = 0.3 + 0.4 * sm;
per_frame_15=decay = 0.990 + 0.008 * min(1, vol * 0.4);
per_frame_16=wave_r = 0.6 + 0.15 * sm + flash * 0.3 * sin(phase * 6.28);
per_frame_17=wave_g = 0.6 + 0.15 * sm + flash * 0.3 * sin(phase * 6.28 + 2.1);
per_frame_18=wave_b = 0.65 + 0.15 * sm + flash * 0.3 * sin(phase * 6.28 + 4.2);
per_frame_19=ob_r = 0.45 + flash * 0.2; ob_g = 0.45 + flash * 0.15; ob_b = 0.5 + flash * 0.1;
per_frame_20=q1 = sb; q2 = sm; q3 = st; q4 = be; q5 = phase; q6 = energy; q7 = flash;
per_pixel_1=zoom = zoom + 0.03 * sin(ang * 6 + time * 0.1) * rad * (1 - rad);
per_pixel_2=rot = rot + 0.02 * sin(ang * 4) * rad * (1 - rad);
shapecode_0_enabled=1
shapecode_0_sides=36
shapecode_0_additive=1
shapecode_0_thickOutline=0
shapecode_0_textured=0
shapecode_0_num_inst=1
