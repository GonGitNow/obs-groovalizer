shapecode_0_border_g=0.800000
shapecode_0_border_b=0.850000
shapecode_0_border_a=0.150000
shape_0_per_frame_1=rad = 0.18 + 0.06 * sin(time * 0.2) + q4 * 0.04;
shape_0_per_frame_2=r = 0.65 + q7 * 0.35 * sin(q5 * 6.28);
shape_0_per_frame_3=g = 0.65 + q7 * 0.35 * sin(q5 * 6.28 + 2.1);
shape_0_per_frame_4=b = 0.70 + q7 * 0.30 * sin(q5 * 6.28 + 4.2);
shape_0_per_frame_5=a = 0.10 + 0.04 * sin(time * 0.3);
shape_0_per_frame_6=border_a = 0.12 + q7 * 0.08;
