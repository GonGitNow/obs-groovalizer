per_frame_init_1=sb = 1; sm = 1; st = 1; be = 0; lb = 0; th = 1.4;
per_frame_init_2=phase = 0; bloom = 0;
per_frame_1=sb = sb * 0.90 + bass * 0.10;
per_frame_2=sm = sm * 0.90 + mid * 0.10;
per_frame_3=st = st * 0.90 + treb * 0.10;
per_frame_4=vol = (bass + mid + treb) / 3;
per_frame_5=beat = above(bass, th) * above(time - lb, 0.25);
per_frame_6=lb = if(beat, time, lb);
per_frame_7=th = if(beat, bass + 0.4, th * 0.998 + 1.3 * 0.002);
per_frame_8=be = be * 0.93 + beat * 0.5;
per_frame_9=phase = phase + 0.002 + 0.001 * st;
per_frame_10=bloom = bloom * 0.92 + be * 0.25;
per_frame_11=zoom = 1.003 + 0.004 * sb;
per_frame_12=rot = 0.001 + 0.0008 * sin(time * 0.09);
per_frame_13=warp = 0.1 + 0.15 * sm;
per_frame_14=decay = 0.97 + 0.02 * min(1, vol * 0.4);
per_frame_15=dx = 0.001 * sin(time * 0.07);
per_frame_16=dy = 0.0008 * cos(time * 0.09);
per_frame_17=mv_a = 0.12 + 0.15 * st + 0.1 * bloom;
per_frame_18=mv_r = 0.25 + 0.15 * sin(phase * 3);
per_frame_19=mv_g = 0.23 + 0.12 * sin(phase * 3 + 0.5);
per_frame_20=mv_b = 0.15 + 0.10 * sin(phase * 3 + 1.5);
per_frame_21=wave_r = 0.8 + 0.2 * bloom;
per_frame_22=wave_g = 0.75 + 0.15 * bloom;
per_frame_23=wave_b = 0.5 + 0.2 * sin(phase * 5);
per_frame_24=wave_a = 0.2 + 0.15 * bloom;
per_frame_25=q1 = sb; q2 = sm; q3 = st; q4 = be; q5 = phase; q6 = bloom;
per_pixel_1=zoom = zoom + 0.006 * rad;
per_pixel_2=rot = rot + 0.002 * (1 - rad) * sin(ang * 4 + time * 0.12);
