shape_0_per_frame1=seed = instance * 5.17 + 2.71;
shape_0_per_frame2=x = 0.05 + 0.9 * (sin(seed * 1.3) * 0.5 + 0.5);
shape_0_per_frame3=y = 0.05 + 0.9 * (cos(seed * 2.7) * 0.5 + 0.5);
shape_0_per_frame4=twinkle = 0.5 + 0.5 * sin(q5 * 10 + instance * 1.7);
