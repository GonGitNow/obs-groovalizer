shape_0_per_frame1=base_r = 0.04 + instance * 0.055;
shape_0_per_frame2=breath = sin(time * 0.4 + instance * 0.8);
shape_0_per_frame3=rad = base_r + 0.02 * breath + 0.005 * q1;
shape_0_per_frame4=ang = q3 * 0.2 * (1 + instance * 0.1);
shape_0_per_frame5=border_a = 0.7 - instance * 0.07;
shape_0_per_frame6=border_r = 0.2 + 0.1 * sin(q3 + instance * 0.9);
shape_0_per_frame7=border_g = 0.4 + 0.2 * sin(q3 + instance * 0.9 + 2);
shape_0_per_frame8=border_b = 0.7 + 0.2 * sin(q3 + instance * 0.9 + 4);
shape_0_per_frame9=a = 0; a2 = 0;
