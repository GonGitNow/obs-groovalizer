per_frame_init_1=sb = 1; sm = 1; st = 1; phase = 0;
per_frame_1=sb = sb * 0.9 + bass * 0.1;
per_frame_2=sm = sm * 0.9 + mid * 0.1;
per_frame_3=st = st * 0.9 + treb * 0.1;
per_frame_4=vol = (bass + mid + treb) / 3;
per_frame_5=phase = phase + 0.005 + 0.002 * sm;
per_frame_6=zoom = 1.0;
per_frame_7=rot = 0.001 * sin(time * 0.08);
per_frame_8=decay = 0.96 + 0.02 * min(1, vol * 0.3);
per_frame_9=wave_a = 0.15 + 0.1 * vol;
per_frame_10=wave_r = 0.2 + 0.2 * sin(phase);
per_frame_11=wave_g = 0.4 + 0.2 * sin(phase + 2);
per_frame_12=wave_b = 0.6 + 0.2 * sin(phase + 4);
per_frame_13=q1 = sb; q2 = sm; q3 = phase; q4 = st; q5 = vol;
per_pixel_1=zoom = 1.0 + 0.003 * sin(rad * 12 + time * 0.5);
per_pixel_2=rot = rot;
