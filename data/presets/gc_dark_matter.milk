per_frame_init_1=smooth_bass = 1; smooth_treb = 1; beat_energy = 0; last_beat = 0; threshold = 1.4;
per_frame_1=smooth_bass = smooth_bass * 0.90 + bass * 0.10;
per_frame_2=smooth_treb = smooth_treb * 0.90 + treb * 0.10;
per_frame_3=vol = (bass + mid + treb) / 3;
per_frame_4=beat = above(bass, threshold) * above(time - last_beat, 0.25);
per_frame_5=last_beat = if(beat, time, last_beat);
per_frame_6=threshold = if(beat, bass + 0.4, threshold * 0.996 + 1.3 * 0.004);
per_frame_7=beat_energy = beat_energy * 0.95 + beat * 0.3;
per_frame_8=zoom = 1.002 + 0.002 * smooth_bass;
per_frame_9=rot = 0.0005 * sin(time * 0.08);
per_frame_10=decay = 0.965 + 0.015 * min(1, vol * 0.4);
per_frame_11=mv_a = 0.06 + 0.06 * smooth_bass;
per_frame_12=wave_r = 0.3 + 0.1 * sin(time * 0.15);
per_frame_13=wave_g = 0.15 + 0.05 * sin(time * 0.15 + 1.5);
per_frame_14=wave_b = 0.5 + 0.15 * sin(time * 0.15 + 3.0);
per_frame_15=wave_a = 0.2 + 0.1 * vol;
per_frame_16=q1 = smooth_bass; q2 = smooth_treb; q3 = beat_energy; q4 = vol; q5 = time;
per_frame_17=q6 = sin(time * 0.07); q7 = cos(time * 0.07); q8 = sin(time * 0.11); q9 = cos(time * 0.11);
per_pixel_1=gx1 = 0.5 + 0.25 * q6; gy1 = 0.5 + 0.25 * q7;
per_pixel_2=gx2 = 0.5 + 0.25 * q8; gy2 = 0.5 + 0.25 * q9;
per_pixel_3=px = x; py = y;
per_pixel_4=d1x = px - gx1; d1y = py - gy1;
per_pixel_5=dist1 = sqrt(d1x * d1x + d1y * d1y) + 0.01;
per_pixel_6=d2x = px - gx2; d2y = py - gy2;
per_pixel_7=dist2 = sqrt(d2x * d2x + d2y * d2y) + 0.01;
per_pixel_8=pull = 0.003 + 0.002 * q1;
per_pixel_9=dx = pull * d1x / (dist1 * dist1 + 0.05) + pull * d2x / (dist2 * dist2 + 0.05);
per_pixel_10=dy = pull * d1y / (dist1 * dist1 + 0.05) + pull * d2y / (dist2 * dist2 + 0.05);
per_pixel_11=dx = min(0.01, max(-0.01, dx));
per_pixel_12=dy = min(0.01, max(-0.01, dy));
