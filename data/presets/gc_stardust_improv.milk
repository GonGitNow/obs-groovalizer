per_frame_1=rot = 0.003 + 0.004*sin(time*0.05)*treb_att;
per_frame_2=zoom = 1.0 + 0.01*bass_att - 0.003*treb;
per_frame_3=warp = 0.3 + 0.4*sin(time*0.04) + 0.2*mid_att;
per_frame_4=wave_r = 0.8 + 0.2*sin(time*0.15);
per_frame_5=wave_g = 0.7 + 0.2*sin(time*0.18 + 1.0);
