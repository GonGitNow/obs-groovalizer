per_frame_8=dx = 0.003*sin(time*0.08)*treb_att;
per_frame_9=dy = 0.003*cos(time*0.07)*treb_att;
per_frame_10=fVideoEchoAlpha = 0.25 + 0.15*mid_att;
per_pixel_1=rot = rot + 0.008*sin(rad*6.283*4.0 + time*0.2)*treb_att;
per_pixel_2=zoom = zoom + 0.005*cos(ang*5.0)*mid_att;
per_pixel_3=dx = dx + 0.002*sin(ang*8.0 + rad*5.0)*treb_att;
