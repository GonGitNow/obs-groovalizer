per_frame_init_1=sb = 1; sm = 1; st = 1; be = 0; lb = 0; th = 1.4;
per_frame_init_2=phase = 0; bright = 0;
per_frame_1=sb = sb * 0.88 + bass * 0.12;
per_frame_2=sm = sm * 0.90 + mid * 0.10;
per_frame_3=st = st * 0.90 + treb * 0.10;
per_frame_4=vol = (bass + mid + treb) / 3;
per_frame_5=beat = above(bass, th) * above(time - lb, 0.25);
per_frame_6=lb = if(beat, time, lb);
per_frame_7=th = if(beat, bass + 0.35, th * 0.997 + 1.3 * 0.003);
per_frame_8=be = be * 0.92 + beat * 0.5;
per_frame_9=phase = phase + 0.0015 + 0.0008 * sm;
per_frame_10=bright = bright * 0.9 + sb * 0.15;
per_frame_11=zoom = 1.000 + 0.001 * sm;
per_frame_12=rot = 0.0005 * sin(time * 0.05);
per_frame_13=warp = 0.3 + 0.2 * sm;
per_frame_14=decay = 0.975 + 0.015 * min(1, vol * 0.4);
per_frame_15=dy = -0.001;
per_frame_16=wave_r = 0.05 + 0.15 * sin(phase * 6.28 + 4.0);
per_frame_17=wave_g = 0.5 + 0.3 * bright;
per_frame_18=wave_b = 0.3 + 0.2 * sin(phase * 6.28 + 2.0);
per_frame_19=wave_a = 0.4 + 0.3 * bright;
per_frame_20=ob_g = 0.03 + 0.04 * bright;
per_frame_21=q1 = sb; q2 = sm; q3 = st; q4 = be; q5 = phase; q6 = bright;
per_pixel_1=dx = 0.005 * sin(y * 6.28 * 2 + time * 0.2) * (1 - abs(y - 0.3));
per_pixel_2=dy = -0.001 + 0.001 * sin(x * 6.28 * 3 + time * 0.15);
per_pixel_3=warp = warp + 0.15 * sin(y * 4 + time * 0.1);
