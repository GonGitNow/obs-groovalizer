wave_0_per_point1=x = sample;
wave_0_per_point2=y = 0.3 + value1 * 0.08 + 0.04 * sin(sample * 20 + q5 * 12);
wave_0_per_point3=r = 0.1 + 0.3 * sin(q5 * 6 + sample * 4);
wave_0_per_point4=g = 0.5 + 0.4 * q6;
wave_0_per_point5=b = 0.3 + 0.3 * sin(q5 * 4 + sample * 6 + 2);
wave_0_per_point6=a = 0.5 + 0.3 * abs(value1);
