wave_1_per_point2=y = 0.5 + value2 * 0.06 + 0.03 * sin(sample * 15 + q5 * 10 + 1.5);
wave_1_per_point3=r = 0.2 + 0.2 * sin(q5 * 5 + sample * 3 + 1);
wave_1_per_point4=g = 0.4 + 0.3 * q6;
