shapecode_0_border_g=0.700000
shapecode_0_border_b=1.000000
shapecode_0_border_a=0.400000
shape_0_per_frame1=seed = instance * 7.31 + 3.14;
shape_0_per_frame2=x = 0.1 + 0.8 * (sin(seed * 1.7) * 0.5 + 0.5);
shape_0_per_frame3=y = 0.1 + 0.8 * (cos(seed * 2.3) * 0.5 + 0.5);
shape_0_per_frame4=rad = 0.005 + 0.015 * sin(q5 * 3 + instance * 0.5);
shape_0_per_frame5=ang = q5 * 0.5 + instance * 0.314;
shape_0_per_frame6=twinkle = 0.5 + 0.5 * sin(q5 * 8 + instance * 2.1);
shape_0_per_frame7=border_a = 0.2 + 0.4 * twinkle + 0.3 * q6;
shape_0_per_frame8=border_r = 0.4 + 0.3 * twinkle;
shape_0_per_frame9=border_g = 0.5 + 0.3 * twinkle;
shape_0_per_frame10=border_b = 0.9;
shape_0_per_frame11=a = 0; a2 = 0;
