shapecode_1_border_b=0.800000
shapecode_1_border_a=0.200000
shape_1_per_frame1=rad = 0.15 + instance * 0.12 + 0.05 * sin(q5 * 2);
shape_1_per_frame2=ang = q5 * 0.2 * (instance + 1);
shape_1_per_frame3=a = 0.04 + 0.03 * q6; a2 = 0.02;
shape_1_per_frame4=r = 0.05 + 0.05 * instance; g = 0.1 + 0.1 * instance; b = 0.4 - 0.05 * instance;
shape_1_per_frame5=border_a = 0.15 + 0.1 * q6;
