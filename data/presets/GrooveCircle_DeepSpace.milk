per_frame_init_1=sb = 1; sm = 1; st = 1; be = 0; lb = 0; th = 1.4;
per_frame_init_2=nebula_phase = 0; star_pulse = 0; drift_x = 0; drift_y = 0;
per_frame_1=sb = sb * 0.9 + bass * 0.1;
per_frame_2=sm = sm * 0.9 + mid * 0.1;
per_frame_3=st = st * 0.9 + treb * 0.1;
per_frame_4=vol = (bass + mid + treb) / 3;
per_frame_5=beat = above(bass, th) * above(time - lb, 0.25);
per_frame_6=lb = if(beat, time, lb);
per_frame_7=th = if(beat, bass + 0.4, th * 0.998 + 1.3 * 0.002);
per_frame_8=be = be * 0.95 + beat * 0.4;
per_frame_9=nebula_phase = nebula_phase + 0.002 + 0.001 * sm;
per_frame_10=star_pulse = star_pulse * 0.9 + be * 0.3;
per_frame_11=drift_x = 0.002 * sin(time * 0.13);
per_frame_12=drift_y = 0.001 * cos(time * 0.17);
per_frame_13=zoom = 1.002 + 0.005 * sb;
per_frame_14=rot = 0.002 + 0.001 * sin(time * 0.11);
per_frame_15=warp = 0.2 + 0.3 * sm;
per_frame_16=decay = 0.98 + 0.015 * min(1, vol * 0.5);
per_frame_17=dx = drift_x; dy = drift_y;
per_frame_18=wave_r = 0.3 + 0.2 * sin(nebula_phase * 6.28);
per_frame_19=wave_g = 0.4 + 0.3 * sin(nebula_phase * 6.28 + 2.5);
per_frame_20=wave_b = 0.8 + 0.2 * sin(nebula_phase * 6.28 + 4);
per_frame_21=wave_a = 0.3 + 0.2 * star_pulse;
per_frame_22=mv_a = 0.08 + 0.12 * st;
per_frame_23=mv_r = 0.1 + 0.1 * sin(nebula_phase * 4);
per_frame_24=mv_g = 0.15 + 0.1 * sin(nebula_phase * 4 + 2);
per_frame_25=mv_b = 0.3 + 0.15 * sin(nebula_phase * 4 + 4);
per_frame_26=q1 = sb; q2 = sm; q3 = st; q4 = be; q5 = nebula_phase; q6 = star_pulse;
per_pixel_1=zoom = zoom + 0.01 * sin(rad * 8 + time * 0.3);
per_pixel_2=rot = rot + 0.003 * sin(ang * 2 + time * 0.2) * (1 - rad);
per_pixel_3=warp = warp + 0.2 * rad;
wavecode_0_enabled=1
wavecode_0_samples=512
wavecode_0_sep=0
wavecode_0_bSpectrum=0
wavecode_0_bUseDots=1
wavecode_0_bDrawThick=1
wavecode_0_bAdditive=1
