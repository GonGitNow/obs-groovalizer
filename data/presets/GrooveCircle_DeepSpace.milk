wavecode_0_smoothing=0.800000
wavecode_0_r=0.500000
wavecode_0_g=0.700000
wavecode_0_b=1.000000
wavecode_0_a=0.800000
wave_0_per_point1=spread = 0.4;
wave_0_per_point2=x = 0.5 + (value1 * spread + 0.01 * sin(sample * 50 + q5 * 10)) * aspecty;
wave_0_per_point3=y = 0.5 + value2 * spread + 0.01 * cos(sample * 50 + q5 * 10);
wave_0_per_point4=r = 0.3 + 0.4 * abs(value1);
wave_0_per_point5=g = 0.5 + 0.3 * abs(value2);
wave_0_per_point6=b = 0.9;
wave_0_per_point7=a = 0.4 + 0.6 * (abs(value1) + abs(value2)) * 0.5;
