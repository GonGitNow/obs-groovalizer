per_frame_1=rot = 0.015 + 0.005*bass_att;
per_frame_2=zoom = 1.0 + 0.005*sin(time*0.04);
per_frame_3=warp = 0.8 + 0.5*sin(time*0.03) + 0.3*mid_att;
per_frame_4=wave_r = 0.7 + 0.3*sin(time*0.1);
per_frame_5=wave_g = 0.5 + 0.3*sin(time*0.13 + 2.0);
per_frame_6=wave_b = 0.9 + 0.1*cos(time*0.11);
per_frame_7=fVideoEchoAlpha = 0.4 + 0.2*sin(time*0.05);
per_frame_8=mv_a = 0.15 + 0.1*mid_att;
per_frame_9=mv_r = 0.4 + 0.3*sin(time*0.08);
per_frame_10=mv_b = 0.7 + 0.3*cos(time*0.09);
per_pixel_1=rot = rot + 0.01*sin(rad*6.283*3.0 + time*0.15)*bass_att;
per_pixel_2=zoom = zoom + 0.008*sin(ang*6.0 + time*0.2)*mid_att;
per_pixel_3=dx = 0.002*sin(ang*3.0 + rad*10.0)*treb_att;
per_pixel_4=dy = 0.002*cos(ang*3.0 + rad*10.0)*treb_att;
