per_frame_1=q1 = bass_att;
per_frame_2=q2 = mid_att;
per_frame_3=zoom = 1.0 + 0.035*q1 - 0.01*treb;
per_frame_4=warp = 0.3 + 0.5*q1 + 0.2*q2;
per_frame_5=rot = 0.006*sin(time*0.08)*q1;
per_frame_6=fDecay = 0.955 + 0.025*q1;
per_frame_7=wave_r = 0.6 + 0.3*q1;
per_frame_8=wave_g = 0.3 + 0.2*q2;
per_frame_9=wave_b = 0.15 + 0.1*treb_att;
per_frame_10=dx = 0.003*sin(time*0.12)*q2;
per_frame_11=dy = 0.002*cos(time*0.1)*q2;
per_frame_12=sx = 1.0 + 0.003*q1;
per_frame_13=sy = 1.0 + 0.003*q1;
per_pixel_1=zoom = zoom + 0.025*q1*(1.0 - rad*0.7);
per_pixel_2=rot = rot + 0.012*sin(ang*4.0 + time*0.2)*q1*(1.0 - rad);
per_pixel_3=warp = warp + 0.1*sin(ang*8.0)*q2;
