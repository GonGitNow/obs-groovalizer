per_frame_init_1=sb = 1; sm = 1; st = 1; be = 0; lb = 0; th = 1.4;
per_frame_init_2=phase = 0; swell = 0;
per_frame_1=sb = sb * 0.92 + bass * 0.08;
per_frame_2=sm = sm * 0.92 + mid * 0.08;
per_frame_3=st = st * 0.92 + treb * 0.08;
per_frame_4=vol = (bass + mid + treb) / 3;
per_frame_5=beat = above(bass, th) * above(time - lb, 0.3);
per_frame_6=lb = if(beat, time, lb);
per_frame_7=th = if(beat, bass + 0.35, th * 0.998 + 1.3 * 0.002);
per_frame_8=be = be * 0.94 + beat * 0.4;
per_frame_9=phase = phase + 0.001 + 0.0005 * sm;
per_frame_10=swell = swell * 0.95 + be * 0.15;
per_frame_11=zoom = 0.999 + 0.003 * sb;
per_frame_12=rot = 0.0008 * sin(time * 0.06);
per_frame_13=warp = 0.8 + 0.5 * sm + 0.2 * swell;
per_frame_14=decay = 0.982 + 0.015 * min(1, vol * 0.4);
per_frame_15=dx = 0.004 * sin(time * 0.07) + 0.001 * sin(time * 0.19);
per_frame_16=dy = 0.002 * cos(time * 0.11) + 0.001 * cos(time * 0.23);
per_frame_17=cx = 0.5 + 0.03 * sin(time * 0.05);
per_frame_18=cy = 0.5 + 0.02 * cos(time * 0.07);
per_frame_19=wave_r = 0.05 + 0.05 * swell;
per_frame_20=wave_g = 0.3 + 0.15 * sin(phase * 4);
per_frame_21=wave_b = 0.4 + 0.15 * sin(phase * 4 + 1);
per_frame_22=wave_a = 0.3 + 0.2 * swell;
per_frame_23=ob_g = 0.02 + 0.02 * swell;
per_frame_24=ob_b = 0.05 + 0.03 * swell;
per_frame_25=q1 = sb; q2 = sm; q3 = st; q4 = be; q5 = phase; q6 = swell;
per_pixel_1=warp = warp + 0.4 * sin(rad * 4 + time * 0.1) + 0.2 * sin(ang * 2 + time * 0.08);
per_pixel_2=dx = dx + 0.003 * sin(y * 8 + time * 0.12);
per_pixel_3=dy = dy + 0.002 * cos(x * 6 + time * 0.1);
per_pixel_4=zoom = zoom + 0.005 * sin(rad * 3 + ang + time * 0.08);
wavecode_0_enabled=1
wavecode_0_samples=256
wavecode_0_sep=0
wavecode_0_bSpectrum=0
wavecode_0_bUseDots=1
wavecode_0_bDrawThick=1
wavecode_0_bAdditive=1
wavecode_0_scaling=0.500000
wavecode_0_smoothing=0.800000
wavecode_0_r=0.100000
wavecode_0_g=0.500000
wavecode_0_b=0.600000
wavecode_0_a=0.700000
wave_0_per_point1=flow_a = sample * 6.283 * 2 + q5 * 6;
wave_0_per_point2=flow_r = 0.15 + 0.1 * sin(sample * 8 + q5 * 4) + value1 * 0.04;
wave_0_per_point3=x = 0.5 + flow_r * cos(flow_a) * aspecty + 0.1 * sin(sample * 12 + q5 * 8) * value1;
wave_0_per_point4=y = 0.5 + flow_r * sin(flow_a) + 0.08 * cos(sample * 10 + q5 * 6) * value2;
wave_0_per_point5=r = 0.05 + 0.1 * abs(value1);
wave_0_per_point6=g = 0.4 + 0.3 * sin(q5 * 5 + sample * 3);
wave_0_per_point7=b = 0.5 + 0.3 * sin(q5 * 4 + sample * 2 + 1);
wave_0_per_point8=a = 0.4 + 0.4 * (abs(value1) + abs(value2)) * 0.5;
wavecode_1_enabled=1
wavecode_1_samples=256
wavecode_1_sep=0
wavecode_1_bSpectrum=0
wavecode_1_bUseDots=1
wavecode_1_bDrawThick=1
wavecode_1_bAdditive=1
wavecode_1_scaling=0.400000
wavecode_1_smoothing=0.850000
wavecode_1_r=0.050000
wavecode_1_g=0.400000
wavecode_1_b=0.500000
wavecode_1_a=0.500000
wave_1_per_point1=flow_a = sample * 6.283 * 3 + q5 * 4 + 2;
wave_1_per_point2=flow_r = 0.25 + 0.08 * sin(sample * 6 + q5 * 3) + value2 * 0.03;
wave_1_per_point3=x = 0.5 + flow_r * cos(flow_a) * aspecty;
wave_1_per_point4=y = 0.5 + flow_r * sin(flow_a);
wave_1_per_point5=r = 0.03; g = 0.3 + 0.2 * sin(q5 * 3 + sample * 5); b = 0.5 + 0.2 * cos(q5 * 4);
wave_1_per_point6=a = 0.3 + 0.3 * abs(value2);
