shapecode_0_border_b=0.400000
shapecode_0_border_a=0.200000
shape_0_per_frame1=rad = 0.12 + instance * 0.1 + 0.04 * sin(q5 * 2 + instance * 1.5);
shape_0_per_frame2=ang = q5 * 0.1 * (instance + 1);
shape_0_per_frame3=x = 0.5 + 0.03 * sin(q5 * 3 + instance * 2);
shape_0_per_frame4=y = 0.5 + 0.02 * cos(q5 * 2 + instance * 2.5);
shape_0_per_frame5=a = 0.04 + 0.03 * q6; a2 = 0.02;
shape_0_per_frame6=border_a = 0.15 + 0.1 * q6;
shape_0_per_frame7=border_g = 0.2 + 0.15 * sin(q5 * 3); border_b = 0.35 + 0.1 * cos(q5 * 2);
