// GENERATED by shared/groove-spec/tools/build-shaders.mjs from shared/groove-spec/scenes/kleinian_veil.gsl
// Do not edit by hand — edit the .gsl source and re-run the generator.
uniform float4x4 ViewProj;

uniform float2 gResolution;
uniform float  gTime;
uniform float  gAspect;
uniform float  gBass;
uniform float  gMid;
uniform float  gTreble;
uniform float  gLevel;
uniform float  gBeat;
uniform float  gPulse;
// Persistent state, integrated on the host and handed in — a shader keeps
// nothing between frames. gSpin only accumulates (never resets, so a scene
// keyed to it never repeats); gTurn latches on bass then relaxes; gWander*
// eases to a new target on each beat; gSlow tracks position within the track.
// Keying motion to these is what makes a scene evolve rather than oscillate.
uniform float  gSpin;
uniform float  gTurn;
uniform float  gWanderX;
uniform float  gWanderY;
uniform float  gSlow;

uniform float  gIntensity;
uniform float  gReactivity;
uniform float3 gColA;
uniform float3 gColB;
uniform float3 gColC;
uniform float3 gColD;
uniform float3 gColE;
uniform float  gColCount;
uniform int    gOctaves;
uniform float  gFreqLo;
uniform float  gFreqHi;

uniform texture2d gSpectrum;
uniform texture2d gWave;
uniform texture2d gFeedback;

sampler_state linearClamp {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in) {
    VertData v_out;
    v_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    v_out.uv  = v_in.uv;
    return v_out;
}

// NOTE: no overloading. OBS's effect parser matches functions by name only
// (effect-parser.c, ep_getfunc) and returns the first match, so a second
// gmod taking float2 would never be reached and every vector call would
// silently bind to the scalar body.
float gmod(float a, float b)      { return a - b * floor(a / b); }
float2 gmod2(float2 a, float2 b)  { return a - b * floor(a / b); }

// Screen-space derivatives. Spelled three different ways across the dialects,
// so scenes use the neutral names.
#define gddx(x) ddx(x)
#define gddy(x) ddy(x)
#define gfwidth(x) fwidth(x)

float2 rotate(float2 p, float a) {
    float s = sin(a), c = cos(a);
    return float2(p.x * c - p.y * s, p.x * s + p.y * c);
}

float hash11(float p) {
    p = frac(p * 0.1031);
    p *= p + 33.33;
    p *= p + p;
    return frac(p);
}

float hash21(float2 p) {
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, float3(p3.y, p3.z, p3.x) + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float vnoise(float2 p) {
    float2 i = floor(p), f = frac(p);
    f = f * f * (3.0 - 2.0 * f);
    float a = hash21(i);
    float b = hash21(i + float2(1.0, 0.0));
    float c = hash21(i + float2(0.0, 1.0));
    float d = hash21(i + float2(1.0, 1.0));
    return lerp(lerp(a, b, f.x), lerp(c, d, f.x), f.y);
}

float fbm(float2 p, int octaves) {
    float sum = 0.0, amp = 0.5, norm = 0.0;
    for (int i = 0; i < 6; i++) {
        if (i >= octaves) break;
        sum += vnoise(p) * amp;
        norm += amp;
        p = rotate(p, 0.5) * 2.02;
        amp *= 0.5;
    }
    return sum / max(norm, 0.00001);
}

// The scene's own previous frame — see the GLSL prelude for what it is for.
// The v flip is load-bearing. Metal and the OBS/HLSL path write render targets
// with a top-left origin but hand the scene a bottom-left uvRaw, so sampling the
// previous frame at p reads it upside down.
//
// This is not cosmetic. With F the flip, applying F.R(theta) twice gives
// R(-theta).R(theta) = identity — so differential rotation, the whole point of
// the feedback idiom, cancelled to nothing on these two backends, and every
// long-memory scene converged to a top-bottom mirror of itself. Only GLSL was
// ever correct. Post.metal already carried this fix and a comment; the scene
// prelude never got the same treatment.
float3 feedback(float2 p) {
    float2 f = clamp(p, float2(0.0, 0.0), float2(1.0, 1.0));
    return gFeedback.Sample(linearClamp, float2(f.x, 1.0 - f.y)).rgb;
}

float3 themePick(float i) {
    if (i < 0.5) return gColA;
    if (i < 1.5) return gColB;
    if (i < 2.5) return gColC;
    if (i < 3.5) return gColD;
    return gColE;
}

float3 theme(float t) {
    float n = max(gColCount, 2.0);
    float s = frac(t) * n;
    float i = floor(s);
    float nx = i + 1.0 >= n ? 0.0 : i + 1.0;
    return lerp(themePick(i), themePick(nx), s - i);
}

// gFreqLo/gFreqHi window the spectrum so "bass focus vs full spectrum" is one
// control that every scene inherits.
float spectrum(float x) {
    float t = lerp(gFreqLo, gFreqHi, clamp(x, 0.0, 1.0));
    return gSpectrum.Sample(linearClamp, float2(clamp(t, 0.0, 1.0), 0.5)).r;
}
float wave(float x)     { return gWave.Sample(linearClamp, float2(clamp(x, 0.0, 1.0), 0.5)).r * 2.0 - 1.0; }

// Kleinian Veil — a loxodromic Möbius map applied to the frame's own memory.
//
// The fractal here is not drawn, it is *grown*. The feedback sample point is a
// Möbius transformation with two fixed points — one attracting, one repelling —
// so every frame the previous image is dragged along the double-spiral flow
// between them. Iterating that map is exactly how a Kleinian limit set is
// generated, so the thin rings injected each frame get copied down the spiral at
// geometrically shrinking scales and the accumulated picture is the limit set of
// the group, drawn in time rather than in a loop.
//
// The fixed points wander, so the two poles of the flow slide across the frame
// and the whole veil reorganises around them. Nothing snaps: the map is within
// 1% of the identity every frame.
//
// gIntensity: ring sharpness, and with it how many filaments stay separable.
//
// @moods trippy, geometric
// @tier  pro
// @cost  4
// @trail 0.07
float3 scene_kleinian_veil(float2 uv, float2 uvRaw) {
    float2 c = uvRaw - 0.5;
    c.x *= gAspect;
    float rad = length(c) * 2.0;

    // ── The two poles ────────────────────────────────────────────────────────
    // Driven by the wander walk, never by the clock, so the pair never returns
    // to a configuration it has already been in.
    float2 f1 = float2(-0.24 + gWanderX * 0.13,  0.11 + gWanderY * 0.10);
    float2 f2 = float2( 0.27 + gWanderY * 0.11, -0.13 - gWanderX * 0.09);

    // S(z) = (z - f1) / (z - f2) sends f1 to 0 and f2 to infinity.
    float2 na = c - f1;
    float2 nb = c - f2;
    float db = max(dot(nb, nb), 1.6e-3);
    float2 s = float2(na.x * nb.x + na.y * nb.y, na.y * nb.x - na.x * nb.y) / db;

    // Multiply by rho * e^{i theta}: loxodromic, so the flow both turns and
    // scales — that combination is what makes the orbits spiral rather than
    // just rotate or just contract.
    float th = 0.0072 * (0.72 + 0.40 * sin(gSpin * 0.47)) + gTurn * 0.0020;
    float rho = 1.0034 + 0.0016 * sin(gSpin * 0.29);
    float cs = cos(th) * rho;
    float sn = sin(th) * rho;
    float2 s2 = float2(s.x * cs - s.y * sn, s.x * sn + s.y * cs);

    // Back again: z = (f1 - f2 * S) / (1 - S).
    float2 fs = float2(f2.x * s2.x - f2.y * s2.y, f2.x * s2.y + f2.y * s2.x);
    float2 num = f1 - fs;
    float2 den = float2(1.0, 0.0) - s2;
    float dd = max(dot(den, den), 1.6e-3);
    float2 q = float2(num.x * den.x + num.y * den.y, num.y * den.x - num.x * den.y) / dd;

    // Speed limiter. A Mobius map is unbounded near the point it sends to
    // infinity, so without this a band of pixels moves tens of pixels in one
    // frame and the feedback records each hop as a separate copy — a visible
    // staircase of hard-edged blocks, which then gets funnelled into the middle
    // of the picture by the flow and stays there. Dividing by (lim + d) rather
    // than clamping keeps it smooth: displacements well under lim pass through
    // essentially untouched, and nothing can ever exceed lim.
    float2 dvec = q - c;
    float lim = 0.0075;
    q = c + dvec * (lim / (lim + length(dvec)));

    // A drift floor. A Mobius map has a fixed point, and around it the flow is
    // smoothly near zero — so a wide region of the frame moves a fraction of a
    // pixel per frame. The renderer binds no sampler state for the scene pass,
    // so feedback() point-samples, and a sub-pixel displacement rounds to zero
    // over one patch and to one pixel over the next: the boundary between those
    // two patches is a straight line on the pixel grid, and hundreds of frames
    // of it etch hard-edged blocks into the picture. Keeping every pixel moving
    // at least a pixel or so per frame is what stops that from being visible.
    float dh = gWanderX * 3.1 + 0.6 * sin(gSpin);
    q += float2(cos(dh), sin(dh)) * 0.0030;

    // A little differential rotation on top, so the sheet shears as it flows.
    q = rotate(q, 0.0022 * (1.0 / (0.5 + rad * 1.4))
                 * (0.6 + 0.4 * sin(gSpin * 0.38 + rad * 2.0)));
    q.x /= gAspect;

    // Super-elliptic border fade. A smoothstep here has a derivative kink at
    // each edge, and multiplying that kink into the buffer every frame etches a
    // visible rounded rectangle across the picture. This is smooth everywhere.
    float2 fq = q * 2.0;
    float inside = exp(-(pow(abs(fq.x), 10.0) + pow(abs(fq.y), 10.0)) * 3.0);
    float decay = 0.9905;
    // Near the point the map sends to infinity the denominator collapses and the
    // clamp above turns a small disc into one constant sample point — which
    // reads as a solid block with straight edges. Fade the memory out there
    // instead of letting the clamp draw it.
    float safe = smoothstep(0.045, 0.150, sqrt(dd));
    // This scene's flow runs *inward*, toward the attracting fixed point, which
    // every other feedback scene here does not: they zoom outward and lose their
    // border to the frame edge. Running inward means anything the border clamp
    // fabricates gets carried into the middle of the picture and kept, and the
    // clamp fabricates straight-edged blocks by resampling one edge row. So the
    // memory has to reach exactly zero before the frame edge, not merely a small
    // number at it.
    float2 eq = float2(1.0, 1.0) - smoothstep(0.452, 0.499, abs(q));
    float3 col = feedback(q + 0.5) * decay * (inside * safe * eq.x * eq.y);
    float gainComp = 1.0 - decay;

    // ── The Schottky circles ─────────────────────────────────────────────────
    // Thin rings, not blobs: a soft source blurs every copy into one lump, and
    // the whole point is that the copies stay separable down the spiral.
    float ink = 0.0;
    // Wider than the hairline this started as. The renderer binds no sampler
    // state for the scene pass, so feedback() point-samples, and a ring only a
    // pixel or two across leaves a visible stair of hard-edged copies as it is
    // resampled. Five pixels of ring survives that intact.
    float sharp = 130.0 + gIntensity * 150.0;
    for (int i = 0; i < 4; i++) {
        float fi = float(i);
        // 2pi-periodic in gSpin, so the ring positions do not jump when the
        // analyzer wraps the integrated angle back to zero.
        float a = fi * 1.5707963 + 0.30 * sin(gSpin) + gWanderY * 0.85;
        float2 o = float2(cos(a), sin(a)) * (0.16 + fi * 0.042)
                 + float2(gWanderX, gWanderY) * 0.09;
        // Radius off gSlow, not off spectrum(). A per-frame spectrum value
        // steps the ring by several pixels between frames and the feedback
        // keeps every one of those steps, which renders as a staircase.
        float rr = 0.062 + fi * 0.026 + gSlow * 0.022;
        float bnd = spectrum(0.12 + fi * 0.22 + gSlow * 0.12);
        float ring = exp(-abs(length(c - o) - rr) * sharp);
        ink += ring * (0.30 + bnd * 1.10);
    }

    // A faint asymmetric wash so the flow always has some substance to carry
    // between the poles, not just four curves.
    float wash = exp(-length(c - (f1 + f2) * 0.5) * 7.5) * (0.02 + gSlow * 0.05);

    col += theme(frac(rad * 0.35 + 0.05 * sin(gSpin) + gSlow * 0.26))
         * (ink * 6.4 + wash) * gainComp;
    col += theme(0.68) * 0.011 * gainComp;
    return col;
}

float4 PSDefault(VertData v_in) : TARGET {
    float2 uvRaw = float2(v_in.uv.x, 1.0 - v_in.uv.y);
    float2 uv = uvRaw * 2.0 - 1.0;
    uv.x *= gAspect;
    return float4(scene_kleinian_veil(uv, uvRaw), 1.0);
}

technique Draw {
    pass {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = PSDefault(v_in);
    }
}
