// GENERATED by shared/groove-spec/tools/build-shaders.mjs from shared/groove-spec/scenes/lyapunov_reef.gsl
// Do not edit by hand — edit the .gsl source and re-run the generator.
uniform float4x4 ViewProj;

uniform float2 gResolution;
uniform float  gTime;
uniform float  gAspect;
uniform float  gBass;
uniform float  gMid;
uniform float  gTreble;
uniform float  gLevel;
uniform float  gBeat;
uniform float  gPulse;
// Persistent state, integrated on the host and handed in — a shader keeps
// nothing between frames. gSpin only accumulates (never resets, so a scene
// keyed to it never repeats); gTurn latches on bass then relaxes; gWander*
// eases to a new target on each beat; gSlow tracks position within the track.
// Keying motion to these is what makes a scene evolve rather than oscillate.
uniform float  gSpin;
uniform float  gTurn;
uniform float  gWanderX;
uniform float  gWanderY;
uniform float  gSlow;

uniform float  gIntensity;
uniform float  gReactivity;
uniform float3 gColA;
uniform float3 gColB;
uniform float3 gColC;
uniform float3 gColD;
uniform float3 gColE;
uniform float  gColCount;
uniform int    gOctaves;
uniform float  gFreqLo;
uniform float  gFreqHi;

uniform texture2d gSpectrum;
uniform texture2d gWave;
uniform texture2d gFeedback;

sampler_state linearClamp {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in) {
    VertData v_out;
    v_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    v_out.uv  = v_in.uv;
    return v_out;
}

// NOTE: no overloading. OBS's effect parser matches functions by name only
// (effect-parser.c, ep_getfunc) and returns the first match, so a second
// gmod taking float2 would never be reached and every vector call would
// silently bind to the scalar body.
float gmod(float a, float b)      { return a - b * floor(a / b); }
float2 gmod2(float2 a, float2 b)  { return a - b * floor(a / b); }

// Screen-space derivatives. Spelled three different ways across the dialects,
// so scenes use the neutral names.
#define gddx(x) ddx(x)
#define gddy(x) ddy(x)
#define gfwidth(x) fwidth(x)

float2 rotate(float2 p, float a) {
    float s = sin(a), c = cos(a);
    return float2(p.x * c - p.y * s, p.x * s + p.y * c);
}

float hash11(float p) {
    p = frac(p * 0.1031);
    p *= p + 33.33;
    p *= p + p;
    return frac(p);
}

float hash21(float2 p) {
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, float3(p3.y, p3.z, p3.x) + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float vnoise(float2 p) {
    float2 i = floor(p), f = frac(p);
    f = f * f * (3.0 - 2.0 * f);
    float a = hash21(i);
    float b = hash21(i + float2(1.0, 0.0));
    float c = hash21(i + float2(0.0, 1.0));
    float d = hash21(i + float2(1.0, 1.0));
    return lerp(lerp(a, b, f.x), lerp(c, d, f.x), f.y);
}

float fbm(float2 p, int octaves) {
    float sum = 0.0, amp = 0.5, norm = 0.0;
    for (int i = 0; i < 6; i++) {
        if (i >= octaves) break;
        sum += vnoise(p) * amp;
        norm += amp;
        p = rotate(p, 0.5) * 2.02;
        amp *= 0.5;
    }
    return sum / max(norm, 0.00001);
}

// The scene's own previous frame — see the GLSL prelude for what it is for.
// The v flip is load-bearing. Metal and the OBS/HLSL path write render targets
// with a top-left origin but hand the scene a bottom-left uvRaw, so sampling the
// previous frame at p reads it upside down.
//
// This is not cosmetic. With F the flip, applying F.R(theta) twice gives
// R(-theta).R(theta) = identity — so differential rotation, the whole point of
// the feedback idiom, cancelled to nothing on these two backends, and every
// long-memory scene converged to a top-bottom mirror of itself. Only GLSL was
// ever correct. Post.metal already carried this fix and a comment; the scene
// prelude never got the same treatment.
float3 feedback(float2 p) {
    float2 f = clamp(p, float2(0.0, 0.0), float2(1.0, 1.0));
    return gFeedback.Sample(linearClamp, float2(f.x, 1.0 - f.y)).rgb;
}

float3 themePick(float i) {
    if (i < 0.5) return gColA;
    if (i < 1.5) return gColB;
    if (i < 2.5) return gColC;
    if (i < 3.5) return gColD;
    return gColE;
}

float3 theme(float t) {
    float n = max(gColCount, 2.0);
    float s = frac(t) * n;
    float i = floor(s);
    float nx = i + 1.0 >= n ? 0.0 : i + 1.0;
    return lerp(themePick(i), themePick(nx), s - i);
}

// gFreqLo/gFreqHi window the spectrum so "bass focus vs full spectrum" is one
// control that every scene inherits.
float spectrum(float x) {
    float t = lerp(gFreqLo, gFreqHi, clamp(x, 0.0, 1.0));
    return gSpectrum.Sample(linearClamp, float2(clamp(t, 0.0, 1.0), 0.5)).r;
}
float wave(float x)     { return gWave.Sample(linearClamp, float2(clamp(x, 0.0, 1.0), 0.5)).r * 2.0 - 1.0; }

// Lyapunov Reef — the stability map of a driven logistic map, redrawn as it goes.
//
// The drive sequence itself dissolves from one pattern into another, so the
// shapes the map is stable on are never the same shapes for long.
//
// Alternate two growth rates in the logistic map on a fixed schedule and colour
// by the Lyapunov exponent, and you get the reef-like shapes of the classic
// Lyapunov fractal: swollen coral where the orbit is stable, open water where it
// is chaotic. Normally the schedule is a fixed word like AABAB and the picture
// is a fixed image.
//
// Here the schedule is continuous — each slot in the six-step cycle is a blend
// of the two rates, and the blend profile is carried by gSpin and gWander. So
// the shapes do not move, they *convert*: a coral head thins, hollows and closes
// again as a different reef, because the underlying word has changed. The window
// on the (a,b) plane drifts at the same time.
//
// gIntensity: iteration count, and with it how far the fine structure resolves.
//
// @moods organic, geometric
// @tier  pro
// @cost  5
// @trail 0.06
float3 scene_lyapunov_reef(float2 uv, float2 uvRaw) {
    float2 c = uvRaw - 0.5;
    c.x *= gAspect;
    float rad = length(c) * 2.0;

    // Gentler than the other scenes in this pack, and a shorter memory below:
    // the Lyapunov field is made of broad regions, and a broad region resampled
    // a hundred times turns into a plate. Only its contours survive the warp,
    // so the warp is kept light and the contours are what get drawn.
    float rot = 0.0022 * (1.0 / (0.52 + rad * 1.4))
              * (0.70 + 0.34 * sin(gSpin * 0.40 + rad * 1.8));
    float zoomv = 0.9992 + 0.0011 * sin(rad * 2.5 - gSpin * 0.33) + gTurn * 0.0013;
    float2 q = rotate(c, rot) * zoomv + float2(gWanderX, gWanderY) * 0.0010;
    q.x /= gAspect;

    // Super-elliptic border fade. A smoothstep here has a derivative kink at
    // each edge, and multiplying that kink into the buffer every frame etches a
    // visible rounded rectangle across the picture. This is smooth everywhere.
    float2 fq = q * 2.0;
    float inside = exp(-(pow(abs(fq.x), 10.0) + pow(abs(fq.y), 10.0)) * 3.0);
    float decay = 0.9715;
    float3 col = feedback(q + 0.5) * decay * inside;
    float gainComp = 1.0 - decay;

    // ── The window on the parameter plane ────────────────────────────────────
    // Kept up in the chaotic quarter where the stable islands are small and
    // numerous. Lower down, both rates converge and the whole corner is one
    // stable plate — true to the maths, and visually a blank slab.
    // The x factor compensates the aspect so the window stays square.
    // The two rates get different ranges, which is what the classic renders do:
    // one rate held up in the chaotic band and the other swept across the whole
    // period-doubling cascade is where the stable islands sit embedded in chaos.
    // A square window with both rates in the same range puts a featureless
    // stable half-plane in one corner.
    float zw = 1.0 - gSlow * 0.22;
    float ra = clamp(3.800 + gWanderX * 0.055 + c.x * 0.225 * zw, 2.10, 3.995);
    float rb = clamp(3.300 + gWanderY * 0.160 + c.y * 0.700 * zw, 2.10, 3.995);

    // ── The schedule ─────────────────────────────────────────────────────────
    // Six slots, each a blend of the two rates rather than a hard A or B. The
    // blend profile drifts, so the "word" the reef is grown from changes shape
    // continuously instead of switching.
    // gSpin is wrapped to 0..2pi by the analyzer, so a bare multiple of it
    // jumps every time it comes round. Anything that sets a *position* has
    // to be exactly 2pi-periodic in it; sin(gSpin) is, a scaled copy is not.
    float seqK = 1.6 + 0.55 * sin(gSpin);
    float seqPh = gWanderX * 2.4 + 0.55 * sin(gSpin * 2.0) + gSlow * 1.4;
    float seqBias = 0.5 + gWanderY * 0.22;

    float x = 0.5;
    float lam = 0.0;
    float nn = 0.0;
    float iters = 40.0 + floor(gIntensity * 24.0);

    for (int i = 0; i < 64; i++) {
        if (float(i) >= iters) { break; }
        float slot = gmod(float(i), 6.0);
        float m01 = saturate(seqBias + 0.5 * sin(slot * 1.0471976 * seqK + seqPh));
        // Pushed back toward 0 or 1: a genuinely intermediate rate behaves like
        // a single averaged rate and the reef washes out into one plate. This
        // keeps the schedule nearly binary while still crossing continuously.
        m01 = saturate((m01 - 0.5) * 3.2 + 0.5);
        float r = lerp(ra, rb, m01);
        x = saturate(r * x * (1.0 - x));
        if (float(i) >= 6.0) {
            lam += log(max(abs(r * (1.0 - 2.0 * x)), 1.0e-6));
            nn += 1.0;
        }
    }
    lam /= max(nn, 1.0);

    // Negative exponent is a stable orbit — the coral. Positive is chaos, left
    // nearly empty so the reef has water around it.
    float coral = saturate(-lam * 1.9);
    // The zero crossing is where the structure has its edge; steep, so it reads
    // as a coastline rather than a gradient.
    float reefEdge = exp(-abs(lam) * 26.0);
    // Contours of the exponent inside the stable region. A cosine band gives
    // lines whose width follows the gradient, so they smear into a wash exactly
    // where the field is flattest — which is most of the coral. Measuring the
    // distance to the contour in screen units instead keeps every line one
    // pixel across, the same trick the distance estimators use.
    float ls = lam * 3.0;
    float dl = min(frac(ls), 1.0 - frac(ls));
    float lww = gfwidth(ls) * 1.3 + 0.004;
    float grain = 1.0 - smoothstep(0.0, lww, dl);

    float band = spectrum(0.16 + gSlow * 0.24);
    float hi = spectrum(0.58 + gWanderY * 0.16);

    // Lines only. No area fill anywhere: the coral is drawn as its own
    // contour map and its coastline, which is what keeps the reef legible
    // instead of collapsing into a lit slab.
    float ink = coral * grain * (1.10 + band * 2.80)
              + reefEdge * (0.55 + hi * 1.75);

    col += theme(frac(coral * 0.75 + gSlow * 0.26 + 0.04 * sin(gSpin))) * ink * 1.5 * gainComp;
    col += theme(0.86) * 0.011 * gainComp;
    return col;
}

float4 PSDefault(VertData v_in) : TARGET {
    float2 uvRaw = float2(v_in.uv.x, 1.0 - v_in.uv.y);
    float2 uv = uvRaw * 2.0 - 1.0;
    uv.x *= gAspect;
    return float4(scene_lyapunov_reef(uv, uvRaw), 1.0);
}

technique Draw {
    pass {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = PSDefault(v_in);
    }
}
