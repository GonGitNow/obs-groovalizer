// GENERATED by shared/groove-spec/tools/build-shaders.mjs from shared/groove-spec/scenes/slow_bloom.gsl
// Do not edit by hand — edit the .gsl source and re-run the generator.
uniform float4x4 ViewProj;

uniform float2 gResolution;
uniform float  gTime;
uniform float  gAspect;
uniform float  gBass;
uniform float  gMid;
uniform float  gTreble;
uniform float  gLevel;
uniform float  gBeat;
uniform float  gPulse;
// Persistent state, integrated on the host and handed in — a shader keeps
// nothing between frames. gSpin only accumulates (never resets, so a scene
// keyed to it never repeats); gTurn latches on bass then relaxes; gWander*
// eases to a new target on each beat; gSlow tracks position within the track.
// Keying motion to these is what makes a scene evolve rather than oscillate.
uniform float  gSpin;
uniform float  gTurn;
uniform float  gWanderX;
uniform float  gWanderY;
uniform float  gSlow;

uniform float  gIntensity;
uniform float  gReactivity;
uniform float3 gColA;
uniform float3 gColB;
uniform float3 gColC;
uniform float3 gColD;
uniform float3 gColE;
uniform float  gColCount;
uniform int    gOctaves;
uniform float  gFreqLo;
uniform float  gFreqHi;

uniform texture2d gSpectrum;
uniform texture2d gWave;
uniform texture2d gFeedback;

sampler_state linearClamp {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in) {
    VertData v_out;
    v_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    v_out.uv  = v_in.uv;
    return v_out;
}

// NOTE: no overloading. OBS's effect parser matches functions by name only
// (effect-parser.c, ep_getfunc) and returns the first match, so a second
// gmod taking float2 would never be reached and every vector call would
// silently bind to the scalar body.
float gmod(float a, float b)      { return a - b * floor(a / b); }
float2 gmod2(float2 a, float2 b)  { return a - b * floor(a / b); }

// Screen-space derivatives. Spelled three different ways across the dialects,
// so scenes use the neutral names.
#define gddx(x) ddx(x)
#define gddy(x) ddy(x)
#define gfwidth(x) fwidth(x)

float2 rotate(float2 p, float a) {
    float s = sin(a), c = cos(a);
    return float2(p.x * c - p.y * s, p.x * s + p.y * c);
}

float hash11(float p) {
    p = frac(p * 0.1031);
    p *= p + 33.33;
    p *= p + p;
    return frac(p);
}

float hash21(float2 p) {
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, float3(p3.y, p3.z, p3.x) + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float vnoise(float2 p) {
    float2 i = floor(p), f = frac(p);
    f = f * f * (3.0 - 2.0 * f);
    float a = hash21(i);
    float b = hash21(i + float2(1.0, 0.0));
    float c = hash21(i + float2(0.0, 1.0));
    float d = hash21(i + float2(1.0, 1.0));
    return lerp(lerp(a, b, f.x), lerp(c, d, f.x), f.y);
}

float fbm(float2 p, int octaves) {
    float sum = 0.0, amp = 0.5, norm = 0.0;
    for (int i = 0; i < 6; i++) {
        if (i >= octaves) break;
        sum += vnoise(p) * amp;
        norm += amp;
        p = rotate(p, 0.5) * 2.02;
        amp *= 0.5;
    }
    return sum / max(norm, 0.00001);
}

// The scene's own previous frame — see the GLSL prelude for what it is for.
// The v flip is load-bearing. Metal and the OBS/HLSL path write render targets
// with a top-left origin but hand the scene a bottom-left uvRaw, so sampling the
// previous frame at p reads it upside down.
//
// This is not cosmetic. With F the flip, applying F.R(theta) twice gives
// R(-theta).R(theta) = identity — so differential rotation, the whole point of
// the feedback idiom, cancelled to nothing on these two backends, and every
// long-memory scene converged to a top-bottom mirror of itself. Only GLSL was
// ever correct. Post.metal already carried this fix and a comment; the scene
// prelude never got the same treatment.
float3 feedback(float2 p) {
    float2 f = clamp(p, float2(0.0, 0.0), float2(1.0, 1.0));
    return gFeedback.Sample(linearClamp, float2(f.x, 1.0 - f.y)).rgb;
}

float3 themePick(float i) {
    if (i < 0.5) return gColA;
    if (i < 1.5) return gColB;
    if (i < 2.5) return gColC;
    if (i < 3.5) return gColD;
    return gColE;
}

float3 theme(float t) {
    float n = max(gColCount, 2.0);
    float s = frac(t) * n;
    float i = floor(s);
    float nx = i + 1.0 >= n ? 0.0 : i + 1.0;
    return lerp(themePick(i), themePick(nx), s - i);
}

// gFreqLo/gFreqHi window the spectrum so "bass focus vs full spectrum" is one
// control that every scene inherits.
float spectrum(float x) {
    float t = lerp(gFreqLo, gFreqHi, clamp(x, 0.0, 1.0));
    return gSpectrum.Sample(linearClamp, float2(clamp(t, 0.0, 1.0), 0.5)).r;
}
float wave(float x)     { return gWave.Sample(linearClamp, float2(clamp(x, 0.0, 1.0), 0.5)).r * 2.0 - 1.0; }

// Slow Bloom — a field that winds itself up and never quite repeats.
//
// Built against a stated preference for smooth, slow, organic movement and no
// strobing, so it deliberately breaks the habit every other scene in this
// catalog has: **there is no beat impulse anywhere in it.** Nothing snaps,
// nothing flashes. Audio bends the flow it is already in.
//
// Three things carry it:
//
//   Feedback     it resamples its own previous frame, so structure persists and
//                accumulates instead of being recomputed from the clock.
//   Differential rotation  rot is a *field*, not a scalar — inner and outer
//                radii turn at different rates, so the image winds and braids.
//                This was the one geometric property that separated the rated
//                presets: 53% of keeps drive rot per-pixel against 25% of nos.
//   Persistent state  gSpin only ever accumulates and gTurn latches slowly, so
//                the configuration drifts somewhere new and never comes back.
//
// gIntensity: how much the rotation rate varies across the frame.
//
// @moods organic, chill
// @tier  free
// @cost  3
// @trail 0.06
float3 scene_slow_bloom(float2 uv, float2 uvRaw) {
    float2 c = uvRaw - 0.5;
    c.x *= gAspect;

    float rad = length(c) * 2.0;
    float pr = 0.0;   // radius in the injector's own drifting frame

    // ── Differential rotation ────────────────────────────────────────────────
    // The whole scene lives here. A constant rotation is a rigid spin; a
    // rotation that varies with radius is a shear, and a shear applied to its
    // own output every frame is what produces spirals, tendrils and braids.
    //
    // gSpin is integrated on the host and never resets, so the phase keeps
    // advancing across the whole track — the pattern cannot return to an
    // earlier state the way a sin(gTime) term would.
    // The falloff is deliberately steep. A gentle one turns the whole field at
    // nearly the same rate, which is a rigid spin however it is dressed up; the
    // braiding only appears when neighbouring radii genuinely shear past each
    // other. This was 1/(0.45 + rad*1.6) and read as a soft bloom.
    float twist = 0.6 + gIntensity * 1.5;
    float rot = 0.0098 * twist * (1.0 / (0.22 + rad * 2.9))
              * (0.62 + 0.46 * sin(gSpin * 0.9 + rad * 2.4))
              + 0.0016 * sin(gSpin * 0.31);

    // ── Breathing ────────────────────────────────────────────────────────────
    // gTurn latches on bass and relaxes over about half a second, which reads
    // as the field drawing breath rather than being hit. Kept small: the
    // contraction compounds every frame, so 0.004 is already a strong current.
    float zoom = 0.9982
               + 0.0026 * sin(rad * 2.6 - gSpin * 0.55)
               + gTurn * 0.0034 * (0.7 - rad * 0.3);

    // The walk keeps the centre of contraction moving, so nothing drains into a
    // fixed point and the composition never settles.
    float2 drift = float2(gWanderX, gWanderY) * 0.0022;

    float2 q = rotate(c, rot) * zoom + drift;
    q.x /= gAspect;

    // Long memory. High decay is what gives the layered, built-up look; the
    // injection below is scaled by (1 - decay) because inside a loop the steady
    // state is inject/(1-decay), not inject.
    float decay = 0.9915;

    // Fade the feedback toward the border. With zoom below 1 the sample point
    // moves inward, so the image flows *outward* and leaves the frame — and at
    // the edge feedback() clamps, resampling the border pixel every frame into
    // a hard bright band down each side. Masking it means content dissolves as
    // it leaves instead of piling up against the clamp.
    // q is centred on 0 here (the +0.5 to texture space happens at the sample
    // call), so the distance to the border is abs(q), not abs(q - 0.5).
    // Per-axis product, not max(): max() masks a hard rectangle and the corner
    // of that rectangle is plainly visible in the render. Starting the falloff
    // Super-elliptic border fade. A smoothstep here has a derivative kink at
    // each edge, and multiplying that kink into the buffer every frame etches a
    // visible rounded rectangle across the picture. This is smooth everywhere.
    float2 fq = q * 2.0;
    float inside = exp(-(pow(abs(fq.x), 10.0) + pow(abs(fq.y), 10.0)) * 3.0);

    float3 col = feedback(q + 0.5) * decay * inside;
    float gainComp = 1.0 - decay;

    // ── What gets fed in ─────────────────────────────────────────────────────
    // Broad, soft lobes rather than points or rings. The rated keeps ran about
    // twice the wave scale of the rejects, so the forms want to be large: fine
    // detail is destroyed by the warp before it can develop into anything.
    // Off-centre and wandering. A radially symmetric injector just gets rotated
    // by the shear above and still looks symmetric; the winding only becomes
    // visible once there is something asymmetric for it to drag round.
    float2 p = (c - float2(gWanderX, gWanderY) * 0.34
                  - float2(cos(gSpin * 0.23), sin(gSpin * 0.19)) * 0.16) * 2.0;
    float ang = atan2(p.y, p.x);

    // Integer harmonics only — exactly periodic, so the atan2 branch cut can
    // never show up as a seam. (An earlier scene of mine had a visible one.)
    float lobes = 0.55 + 0.45 * sin(3.0 * ang + gSpin * 0.7)
                       * cos(2.0 * ang - gSpin * 0.4);

    // Energy enters as a wide radial swell tied to the bands, with no attack —
    // spectrum() is already smoothed, and nothing here differentiates it.
    float band = spectrum(0.10 + gSlow * 0.30);
    pr = length(p);
    float swell = exp(-pow(abs(pr - (0.45 + band * 0.55)), 2.0) * 18.0);
    float mids = spectrum(0.45 + gWanderX * 0.12);

    float ink = swell * lobes * (0.30 + mids * 1.10);
    // A soft core so the field always has a source to draw from.
    ink += exp(-pr * pr * 7.0) * (0.14 + gTurn * 0.40);

    col += theme(frac(rad * 0.42 + gSpin * 0.045 + gSlow * 0.25)) * ink * 1.5 * gainComp;

    // Embers, so a quiet passage decays toward something rather than nothing.
    col += theme(0.55) * 0.012 * gainComp;

    // No global exposure term: a multiply here would sit inside the feedback
    // path and compound into the decay every frame. Level response belongs in
    // the post chain.
    return col;
}

float4 PSDefault(VertData v_in) : TARGET {
    float2 uvRaw = float2(v_in.uv.x, 1.0 - v_in.uv.y);
    float2 uv = uvRaw * 2.0 - 1.0;
    uv.x *= gAspect;
    return float4(scene_slow_bloom(uv, uvRaw), 1.0);
}

technique Draw {
    pass {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = PSDefault(v_in);
    }
}
