// GENERATED by shared/groove-spec/tools/build-shaders.mjs from shared/groove-spec/scenes/morphogen.gsl
// Do not edit by hand — edit the .gsl source and re-run the generator.
uniform float4x4 ViewProj;

uniform float2 gResolution;
uniform float  gTime;
uniform float  gAspect;
uniform float  gBass;
uniform float  gMid;
uniform float  gTreble;
uniform float  gLevel;
uniform float  gBeat;
uniform float  gPulse;
// Persistent state, integrated on the host and handed in — a shader keeps
// nothing between frames. gSpin only accumulates (never resets, so a scene
// keyed to it never repeats); gTurn latches on bass then relaxes; gWander*
// eases to a new target on each beat; gSlow tracks position within the track.
// Keying motion to these is what makes a scene evolve rather than oscillate.
uniform float  gSpin;
uniform float  gTurn;
uniform float  gWanderX;
uniform float  gWanderY;
uniform float  gSlow;

uniform float  gIntensity;
uniform float  gReactivity;
uniform float3 gColA;
uniform float3 gColB;
uniform float3 gColC;
uniform float3 gColD;
uniform float3 gColE;
uniform float  gColCount;
uniform int    gOctaves;
uniform float  gFreqLo;
uniform float  gFreqHi;

uniform texture2d gSpectrum;
uniform texture2d gWave;
uniform texture2d gFeedback;

sampler_state linearClamp {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in) {
    VertData v_out;
    v_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    v_out.uv  = v_in.uv;
    return v_out;
}

// NOTE: no overloading. OBS's effect parser matches functions by name only
// (effect-parser.c, ep_getfunc) and returns the first match, so a second
// gmod taking float2 would never be reached and every vector call would
// silently bind to the scalar body.
float gmod(float a, float b)      { return a - b * floor(a / b); }
float2 gmod2(float2 a, float2 b)  { return a - b * floor(a / b); }

// Screen-space derivatives. Spelled three different ways across the dialects,
// so scenes use the neutral names.
#define gddx(x) ddx(x)
#define gddy(x) ddy(x)
#define gfwidth(x) fwidth(x)

float2 rotate(float2 p, float a) {
    float s = sin(a), c = cos(a);
    return float2(p.x * c - p.y * s, p.x * s + p.y * c);
}

float hash11(float p) {
    p = frac(p * 0.1031);
    p *= p + 33.33;
    p *= p + p;
    return frac(p);
}

float hash21(float2 p) {
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, float3(p3.y, p3.z, p3.x) + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float vnoise(float2 p) {
    float2 i = floor(p), f = frac(p);
    f = f * f * (3.0 - 2.0 * f);
    float a = hash21(i);
    float b = hash21(i + float2(1.0, 0.0));
    float c = hash21(i + float2(0.0, 1.0));
    float d = hash21(i + float2(1.0, 1.0));
    return lerp(lerp(a, b, f.x), lerp(c, d, f.x), f.y);
}

float fbm(float2 p, int octaves) {
    float sum = 0.0, amp = 0.5, norm = 0.0;
    for (int i = 0; i < 6; i++) {
        if (i >= octaves) break;
        sum += vnoise(p) * amp;
        norm += amp;
        p = rotate(p, 0.5) * 2.02;
        amp *= 0.5;
    }
    return sum / max(norm, 0.00001);
}

// The scene's own previous frame — see the GLSL prelude for what it is for.
// The v flip is load-bearing. Metal and the OBS/HLSL path write render targets
// with a top-left origin but hand the scene a bottom-left uvRaw, so sampling the
// previous frame at p reads it upside down.
//
// This is not cosmetic. With F the flip, applying F.R(theta) twice gives
// R(-theta).R(theta) = identity — so differential rotation, the whole point of
// the feedback idiom, cancelled to nothing on these two backends, and every
// long-memory scene converged to a top-bottom mirror of itself. Only GLSL was
// ever correct. Post.metal already carried this fix and a comment; the scene
// prelude never got the same treatment.
float3 feedback(float2 p) {
    float2 f = clamp(p, float2(0.0, 0.0), float2(1.0, 1.0));
    return gFeedback.Sample(linearClamp, float2(f.x, 1.0 - f.y)).rgb;
}

float3 themePick(float i) {
    if (i < 0.5) return gColA;
    if (i < 1.5) return gColB;
    if (i < 2.5) return gColC;
    if (i < 3.5) return gColD;
    return gColE;
}

float3 theme(float t) {
    float n = max(gColCount, 2.0);
    float s = frac(t) * n;
    float i = floor(s);
    float nx = i + 1.0 >= n ? 0.0 : i + 1.0;
    return lerp(themePick(i), themePick(nx), s - i);
}

// gFreqLo/gFreqHi window the spectrum so "bass focus vs full spectrum" is one
// control that every scene inherits.
float spectrum(float x) {
    float t = lerp(gFreqLo, gFreqHi, clamp(x, 0.0, 1.0));
    return gSpectrum.Sample(linearClamp, float2(clamp(t, 0.0, 1.0), 0.5)).r;
}
float wave(float x)     { return gWave.Sample(linearClamp, float2(clamp(x, 0.0, 1.0), 0.5)).r * 2.0 - 1.0; }

// Morphogen — a field that remembers itself, warped differently at every point.
//
// The first scene with memory, and the first built on the MilkDrop idiom rather
// than around it. Every other scene recomputes itself from the clock, so it can
// pulse but never *become* anything.
//
// The load-bearing idea, taken from the preset corpus: `zoom` and `rot` are not
// scalars, they are **fields**. Different parts of the image contract and turn
// at different rates, as harmonics of radius and angle. Applied at ~0.999 per
// frame and compounded over hundreds of frames, that differential is what makes
// structure fold, braid and bloom outward. A uniform zoom only tunnels.
// (In a 400-preset sample, 98% drive a warp variable per-pixel and 69% do it
// from rad/ang.)
//
// gIntensity: how sharply the warp varies across the frame.
//
// @moods trippy, organic
// @tier  pro
// @cost  3
// @trail 0.08
float3 scene_morphogen(float2 uv, float2 uvRaw) {
    // Square, centred space so rotation does not skew on a wide frame.
    float2 c = uvRaw - 0.5;
    c.x *= gAspect;

    float t = gTime * 0.25;
    float rad = length(c) * 2.0;
    // Only ever used inside sin/cos with integer multipliers, which are exactly
    // periodic — so the atan2 branch cut never shows as a seam.
    float ang = atan2(c.y, c.x);

    // ── The warp field ───────────────────────────────────────────────────────
    // Base contraction just under 1. Every term after it is a *variation* about
    // that, so some rings pull inward while others push out — the shear between
    // them is where tendrils come from.
    float sharp = 0.5 + gIntensity;
    float zoom = 0.9975
               + 0.0060 * sin(3.0 * ang + t * 0.7) * sharp
               + 0.0045 * sin(rad * 5.0 - t * 1.1)
               - 0.0030 * cos(rad * 2.0)
               + gPulse * 0.0060 * sin(6.0 * ang);

    // Rotation likewise varies with radius, so the picture winds up rather than
    // spinning rigidly. The beat adds a differential twist, not a global one.
    float rot = 0.0035 * sin(1.2 - rad) * cos(0.6 * (0.5 - rad) + t)
              + gPulse * 0.0130 * (0.6 - rad * 0.35);

    // A slow drift keeps the centre from becoming a fixed point everything
    // drains into.
    float2 drift = float2(sin(t * 0.43), cos(t * 0.37)) * 0.0016;

    float2 q = rotate(c, rot) * zoom + drift;
    q.x /= gAspect;

    // Everything below is inside a feedback loop, so the arithmetic is not the
    // same as drawing once. For `col = col * d + inject`, the steady state is
    // `inject / (1 - d)` — at d = 0.975 that is a 40x amplifier, which is
    // exactly how the first version of this scene saturated to a white blob.
    // So: pick the decay, then scale the injection by (1 - decay) so the
    // equilibrium lands where the injection is actually written.
    float decay = 0.972;
    float3 col = feedback(q + 0.5) * decay;

    // ── New energy ───────────────────────────────────────────────────────────
    // Something for the warp to chew on. Without an injector the picture decays
    // to black; with too much, the warp never gets to develop it.
    float2 p = c * 2.0;
    float ink = 0.0;
    for (int i = 0; i < 3; i++) {
        float fi = float(i);
        // Incommensurate orbits: the emitters never re-form the same
        // arrangement, so the field keeps being given new configurations.
        float2 o = float2(sin(gTime * (0.19 + fi * 0.047) + fi * 2.4) * 0.62,
                          cos(gTime * (0.15 + fi * 0.041) + fi * 1.7) * 0.46);
        float d = length(p - o);
        // Each emitter tracks its own band, so bass and hats build different
        // structures in the same field.
        float band = spectrum(0.08 + fi * 0.36);
        float w = 0.0055 + band * 0.014;
        ink += w / (w + d * d * 30.0) * (0.30 + band * 1.4);
    }

    // A wavefront on the beat. The warp smears it into filaments, which is why
    // one beat leaves a mark that survives for seconds rather than one frame.
    float shell = exp(-abs(length(p) - frac(gTime * 0.27) * 1.5) * 22.0) * gPulse * 0.9;

    float gainComp = 1.0 - decay;
    col += theme(frac(rad * 0.55 + gTime * 0.035 + gBass * 0.12))
         * (ink * 3.4 + shell * 4.0) * gainComp;

    // A floor so a quiet passage fades toward embers rather than to nothing.
    col += theme(0.12) * 0.010 * gainComp;

    // NOT applied here: a global multiply at the end of the scene would sit
    // inside the loop and compound into the decay every frame. Exposure
    // response belongs in the post chain, not in a feedback path.
    return col;
}

float4 PSDefault(VertData v_in) : TARGET {
    float2 uvRaw = float2(v_in.uv.x, 1.0 - v_in.uv.y);
    float2 uv = uvRaw * 2.0 - 1.0;
    uv.x *= gAspect;
    return float4(scene_morphogen(uv, uvRaw), 1.0);
}

technique Draw {
    pass {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = PSDefault(v_in);
    }
}
