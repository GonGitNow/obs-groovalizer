// GENERATED by shared/groove-spec/tools/build-shaders.mjs from shared/groove-spec/scenes/droste_helix.gsl
// Do not edit by hand — edit the .gsl source and re-run the generator.
uniform float4x4 ViewProj;

uniform float2 gResolution;
uniform float  gTime;
uniform float  gAspect;
uniform float  gBass;
uniform float  gMid;
uniform float  gTreble;
uniform float  gLevel;
uniform float  gBeat;
uniform float  gPulse;
// Persistent state, integrated on the host and handed in — a shader keeps
// nothing between frames. gSpin only accumulates (never resets, so a scene
// keyed to it never repeats); gTurn latches on bass then relaxes; gWander*
// eases to a new target on each beat; gSlow tracks position within the track.
// Keying motion to these is what makes a scene evolve rather than oscillate.
uniform float  gSpin;
uniform float  gTurn;
uniform float  gWanderX;
uniform float  gWanderY;
uniform float  gSlow;

uniform float  gIntensity;
uniform float  gReactivity;
uniform float3 gColA;
uniform float3 gColB;
uniform float3 gColC;
uniform float3 gColD;
uniform float3 gColE;
uniform float  gColCount;
uniform int    gOctaves;
uniform float  gFreqLo;
uniform float  gFreqHi;

uniform texture2d gSpectrum;
uniform texture2d gWave;
uniform texture2d gFeedback;

sampler_state linearClamp {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in) {
    VertData v_out;
    v_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    v_out.uv  = v_in.uv;
    return v_out;
}

// NOTE: no overloading. OBS's effect parser matches functions by name only
// (effect-parser.c, ep_getfunc) and returns the first match, so a second
// gmod taking float2 would never be reached and every vector call would
// silently bind to the scalar body.
float gmod(float a, float b)      { return a - b * floor(a / b); }
float2 gmod2(float2 a, float2 b)  { return a - b * floor(a / b); }

// Screen-space derivatives. Spelled three different ways across the dialects,
// so scenes use the neutral names.
#define gddx(x) ddx(x)
#define gddy(x) ddy(x)
#define gfwidth(x) fwidth(x)

float2 rotate(float2 p, float a) {
    float s = sin(a), c = cos(a);
    return float2(p.x * c - p.y * s, p.x * s + p.y * c);
}

float hash11(float p) {
    p = frac(p * 0.1031);
    p *= p + 33.33;
    p *= p + p;
    return frac(p);
}

float hash21(float2 p) {
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, float3(p3.y, p3.z, p3.x) + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float vnoise(float2 p) {
    float2 i = floor(p), f = frac(p);
    f = f * f * (3.0 - 2.0 * f);
    float a = hash21(i);
    float b = hash21(i + float2(1.0, 0.0));
    float c = hash21(i + float2(0.0, 1.0));
    float d = hash21(i + float2(1.0, 1.0));
    return lerp(lerp(a, b, f.x), lerp(c, d, f.x), f.y);
}

float fbm(float2 p, int octaves) {
    float sum = 0.0, amp = 0.5, norm = 0.0;
    for (int i = 0; i < 6; i++) {
        if (i >= octaves) break;
        sum += vnoise(p) * amp;
        norm += amp;
        p = rotate(p, 0.5) * 2.02;
        amp *= 0.5;
    }
    return sum / max(norm, 0.00001);
}

// The scene's own previous frame — see the GLSL prelude for what it is for.
// The v flip is load-bearing. Metal and the OBS/HLSL path write render targets
// with a top-left origin but hand the scene a bottom-left uvRaw, so sampling the
// previous frame at p reads it upside down.
//
// This is not cosmetic. With F the flip, applying F.R(theta) twice gives
// R(-theta).R(theta) = identity — so differential rotation, the whole point of
// the feedback idiom, cancelled to nothing on these two backends, and every
// long-memory scene converged to a top-bottom mirror of itself. Only GLSL was
// ever correct. Post.metal already carried this fix and a comment; the scene
// prelude never got the same treatment.
float3 feedback(float2 p) {
    float2 f = clamp(p, float2(0.0, 0.0), float2(1.0, 1.0));
    return gFeedback.Sample(linearClamp, float2(f.x, 1.0 - f.y)).rgb;
}

float3 themePick(float i) {
    if (i < 0.5) return gColA;
    if (i < 1.5) return gColB;
    if (i < 2.5) return gColC;
    if (i < 3.5) return gColD;
    return gColE;
}

float3 theme(float t) {
    float n = max(gColCount, 2.0);
    float s = frac(t) * n;
    float i = floor(s);
    float nx = i + 1.0 >= n ? 0.0 : i + 1.0;
    return lerp(themePick(i), themePick(nx), s - i);
}

// gFreqLo/gFreqHi window the spectrum so "bass focus vs full spectrum" is one
// control that every scene inherits.
float spectrum(float x) {
    float t = lerp(gFreqLo, gFreqHi, clamp(x, 0.0, 1.0));
    return gSpectrum.Sample(linearClamp, float2(clamp(t, 0.0, 1.0), 0.5)).r;
}
float wave(float x)     { return gWave.Sample(linearClamp, float2(clamp(x, 0.0, 1.0), 0.5)).r * 2.0 - 1.0; }

// Droste Helix — a log-polar spiral that falls into itself forever.
//
// In log-polar coordinates a scale is a translation, so shifting one axis at a
// constant rate is an endless zoom that never arrives anywhere. Shearing the
// same axis against the angle by a whole number of turns is the Droste
// construction: the tiles wind into a spiral whose every turn is a scaled copy
// of the one outside it, and the copies march inward without end.
//
// The shift is gSpin, which never resets, so the zoom is genuinely unbounded
// rather than a loop. The log-period and the fold count are on the wander walk,
// so the spiral's pitch opens and closes over tens of seconds — the same fall,
// through a different staircase each time.
//
// The shear uses whole turns only, which is the one thing that keeps the log
// spiral continuous across the atan2 branch cut.
//
// gIntensity: spiral pitch, i.e. how many rings of it are in frame.
//
// @moods trippy, geometric
// @tier  free
// @cost  3
// @trail 0.07
float3 scene_droste_helix(float2 uv, float2 uvRaw) {
    float2 c = uvRaw - 0.5;
    c.x *= gAspect;
    float rad = length(c) * 2.0;

    // Differential rotation, strongest at the middle where the spiral is
    // tightest, so the turns shear past each other instead of spinning rigidly.
    float rot = 0.0050 * (1.0 / (0.45 + rad * 1.6))
              * (0.70 + 0.36 * sin(gSpin * 0.55 + rad * 2.4));
    float zoomv = 0.9984 + 0.0022 * sin(rad * 2.9 - gSpin * 0.42) + gTurn * 0.0024;
    float2 q = rotate(c, rot) * zoomv + float2(gWanderX, gWanderY) * 0.0012;
    q.x /= gAspect;

    // Super-elliptic border fade. A smoothstep here has a derivative kink at
    // each edge, and multiplying that kink into the buffer every frame etches a
    // visible rounded rectangle across the picture. This is smooth everywhere.
    float2 fq = q * 2.0;
    float inside = exp(-(pow(abs(fq.x), 10.0) + pow(abs(fq.y), 10.0)) * 3.0);
    float decay = 0.9865;
    float3 col = feedback(q + 0.5) * decay * inside;
    float gainComp = 1.0 - decay;

    // ── Log-polar ────────────────────────────────────────────────────────────
    float2 p = c * 2.0 + float2(gWanderX, gWanderY) * 0.26;
    float r = max(length(p), 1.0e-4);
    float a = atan2(p.y, p.x);

    float pl = 0.55 + gIntensity * 0.55 + gSlow * 0.12;     // log period
    // Whole turns only. A fractional shear shifts by a non-integer number of
    // periods across the cut and tears the spiral open along -X.
    float turns = 1.0;
    // The endless zoom. gSpin is wrapped to 0..2pi by the analyzer, so a plain
    // multiple of it would snap the spiral back every wrap. Scaling it by
    // pl * 6 / 2pi makes the wrap shift lu by exactly six log-periods, which
    // frac(lu/pl) cannot see — the zoom stays unbroken and still runs off an
    // integrator that only ever moves forward.
    float lu = log(r) - pl * turns * (a / 6.2831853)
             + gSpin * pl * 0.9549297 + gWanderY * 0.35;
    float cu = frac(lu / pl);          // safe: only frac() of this, never floor

    // Angular cells, sheared along the log axis so the cell walls are spirals
    // too and the tiling reads as a Droste staircase rather than a cartwheel.
    // Both terms jump by a whole number across the branch cut — folds is an
    // integer and lu/pl shifts by exactly `turns` — so frac() stays continuous.
    float folds = 6.0 + floor(gIntensity * 3.0) * 2.0;
    float t01 = frac(a / 6.2831853 + 0.5);
    float av = frac(t01 * folds + lu / pl * 2.0);

    // ── The tile ─────────────────────────────────────────────────────────────
    float du = min(cu, 1.0 - cu);
    float dv = min(av, 1.0 - av);
    float lwU = 0.028 + 0.014 * gIntensity;
    float lwV = 0.034;
    float ribs = (1.0 - smoothstep(0.0, lwU, du)) * 0.85
               + (1.0 - smoothstep(0.0, lwV, dv)) * 0.55;

    // A disc in the middle of each cell so the spiral has bodies, not just a
    // grid — the warp destroys a bare grid before it can develop.
    float2 cell = float2((cu - 0.5) * 2.0, (av - 0.5) * 2.0);
    float bead = exp(-dot(cell, cell) * 7.0);

    // Kill the singular centre and the far corners; the feedback zoom keeps
    // supplying material inward, so nothing is lost by masking there.
    float shape = smoothstep(0.05, 0.26, r) * (1.0 - smoothstep(0.72, 1.15, r));

    float band = spectrum(0.18 + gSlow * 0.24);
    float hi = spectrum(0.64 + gWanderX * 0.15);

    float ink = (ribs * (0.30 + hi * 1.25) + bead * (0.22 + band * 0.85)) * shape;

    col += theme(frac(cu * 0.8 + 0.05 * sin(gSpin) + gSlow * 0.24)) * ink * 2.9 * gainComp;
    col += theme(0.74) * 0.012 * gainComp;
    return col;
}

float4 PSDefault(VertData v_in) : TARGET {
    float2 uvRaw = float2(v_in.uv.x, 1.0 - v_in.uv.y);
    float2 uv = uvRaw * 2.0 - 1.0;
    uv.x *= gAspect;
    return float4(scene_droste_helix(uv, uvRaw), 1.0);
}

technique Draw {
    pass {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = PSDefault(v_in);
    }
}
