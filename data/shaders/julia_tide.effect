// GENERATED by shared/groove-spec/tools/build-shaders.mjs from shared/groove-spec/scenes/julia_tide.gsl
// Do not edit by hand — edit the .gsl source and re-run the generator.
uniform float4x4 ViewProj;

uniform float2 gResolution;
uniform float  gTime;
uniform float  gAspect;
uniform float  gBass;
uniform float  gMid;
uniform float  gTreble;
uniform float  gLevel;
uniform float  gBeat;
uniform float  gPulse;
// Persistent state, integrated on the host and handed in — a shader keeps
// nothing between frames. gSpin only accumulates (never resets, so a scene
// keyed to it never repeats); gTurn latches on bass then relaxes; gWander*
// eases to a new target on each beat; gSlow tracks position within the track.
// Keying motion to these is what makes a scene evolve rather than oscillate.
uniform float  gSpin;
uniform float  gTurn;
uniform float  gWanderX;
uniform float  gWanderY;
uniform float  gSlow;

uniform float  gIntensity;
uniform float  gReactivity;
uniform float3 gColA;
uniform float3 gColB;
uniform float3 gColC;
uniform float3 gColD;
uniform float3 gColE;
uniform float  gColCount;
uniform int    gOctaves;
uniform float  gFreqLo;
uniform float  gFreqHi;

uniform texture2d gSpectrum;
uniform texture2d gWave;
uniform texture2d gFeedback;

sampler_state linearClamp {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in) {
    VertData v_out;
    v_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    v_out.uv  = v_in.uv;
    return v_out;
}

// NOTE: no overloading. OBS's effect parser matches functions by name only
// (effect-parser.c, ep_getfunc) and returns the first match, so a second
// gmod taking float2 would never be reached and every vector call would
// silently bind to the scalar body.
float gmod(float a, float b)      { return a - b * floor(a / b); }
float2 gmod2(float2 a, float2 b)  { return a - b * floor(a / b); }

// Screen-space derivatives. Spelled three different ways across the dialects,
// so scenes use the neutral names.
#define gddx(x) ddx(x)
#define gddy(x) ddy(x)
#define gfwidth(x) fwidth(x)

float2 rotate(float2 p, float a) {
    float s = sin(a), c = cos(a);
    return float2(p.x * c - p.y * s, p.x * s + p.y * c);
}

float hash11(float p) {
    p = frac(p * 0.1031);
    p *= p + 33.33;
    p *= p + p;
    return frac(p);
}

float hash21(float2 p) {
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, float3(p3.y, p3.z, p3.x) + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float vnoise(float2 p) {
    float2 i = floor(p), f = frac(p);
    f = f * f * (3.0 - 2.0 * f);
    float a = hash21(i);
    float b = hash21(i + float2(1.0, 0.0));
    float c = hash21(i + float2(0.0, 1.0));
    float d = hash21(i + float2(1.0, 1.0));
    return lerp(lerp(a, b, f.x), lerp(c, d, f.x), f.y);
}

float fbm(float2 p, int octaves) {
    float sum = 0.0, amp = 0.5, norm = 0.0;
    for (int i = 0; i < 6; i++) {
        if (i >= octaves) break;
        sum += vnoise(p) * amp;
        norm += amp;
        p = rotate(p, 0.5) * 2.02;
        amp *= 0.5;
    }
    return sum / max(norm, 0.00001);
}

// The scene's own previous frame — see the GLSL prelude for what it is for.
// The v flip is load-bearing. Metal and the OBS/HLSL path write render targets
// with a top-left origin but hand the scene a bottom-left uvRaw, so sampling the
// previous frame at p reads it upside down.
//
// This is not cosmetic. With F the flip, applying F.R(theta) twice gives
// R(-theta).R(theta) = identity — so differential rotation, the whole point of
// the feedback idiom, cancelled to nothing on these two backends, and every
// long-memory scene converged to a top-bottom mirror of itself. Only GLSL was
// ever correct. Post.metal already carried this fix and a comment; the scene
// prelude never got the same treatment.
float3 feedback(float2 p) {
    float2 f = clamp(p, float2(0.0, 0.0), float2(1.0, 1.0));
    return gFeedback.Sample(linearClamp, float2(f.x, 1.0 - f.y)).rgb;
}

float3 themePick(float i) {
    if (i < 0.5) return gColA;
    if (i < 1.5) return gColB;
    if (i < 2.5) return gColC;
    if (i < 3.5) return gColD;
    return gColE;
}

float3 theme(float t) {
    float n = max(gColCount, 2.0);
    float s = frac(t) * n;
    float i = floor(s);
    float nx = i + 1.0 >= n ? 0.0 : i + 1.0;
    return lerp(themePick(i), themePick(nx), s - i);
}

// gFreqLo/gFreqHi window the spectrum so "bass focus vs full spectrum" is one
// control that every scene inherits.
float spectrum(float x) {
    float t = lerp(gFreqLo, gFreqHi, clamp(x, 0.0, 1.0));
    return gSpectrum.Sample(linearClamp, float2(clamp(t, 0.0, 1.0), 0.5)).r;
}
float wave(float x)     { return gWave.Sample(linearClamp, float2(clamp(x, 0.0, 1.0), 0.5)).r * 2.0 - 1.0; }

// Julia Tide — a Julia set whose parameter drifts, leaving its history behind.
//
// The classic failure of a fractal visualiser is that it is a *still*: the set
// is beautiful and then it just sits there. This one moves the seed `c` slowly
// along a wandering path, and because the frame is fed back and only partly
// decays, the shapes the set passed through a few seconds ago are still faintly
// present. So it reads as one continuous form turning inside out rather than a
// slideshow of separate fractals.
//
// The seed is driven by gWander and gSlow, never by gTime — so it does not
// retrace a loop, and never by the beat, so it does not jump.
//
// gIntensity: iteration count, and with it how filigreed the boundary gets.
//
// @moods trippy, geometric
// @tier  pro
// @cost  4
// @trail 0.06
float3 scene_julia_tide(float2 uv, float2 uvRaw) {
    float2 c = uvRaw - 0.5;
    c.x *= gAspect;
    float rad = length(c) * 2.0;

    // Feedback transform: a gentle differential rotation, so the accumulated
    // history winds rather than sitting exactly under the new frame.
    float rot = 0.0042 * (1.0 / (0.55 + rad * 1.2))
              * (0.75 + 0.3 * sin(gSpin * 0.6 + rad * 1.9));
    float zoom = 0.9988 + gTurn * 0.0022;
    float2 q = rotate(c, rot) * zoom + float2(gWanderX, gWanderY) * 0.0014;
    q.x /= gAspect;

    // Super-elliptic border fade. A smoothstep here has a derivative kink at
    // each edge, and multiplying that kink into the buffer every frame etches a
    // visible rounded rectangle across the picture. This is smooth everywhere.
    float2 fq = q * 2.0;
    float inside = exp(-(pow(abs(fq.x), 10.0) + pow(abs(fq.y), 10.0)) * 3.0);
    float decay = 0.983;
    float3 col = feedback(q + 0.5) * decay * inside;
    float gainComp = 1.0 - decay;

    // ── The set ──────────────────────────────────────────────────────────────
    // Seed on a slow wander. Kept just outside the main cardioid, where the
    // set is a connected filigree rather than dust.
    float2 seed = float2(-0.74 + gWanderX * 0.16 + gSlow * 0.06,
                          0.16 + gWanderY * 0.14);

    float2 z = c * (1.42 - gTurn * 0.08);
    float trap = 4.0;     // orbit trap: nearest approach to the origin
    float esc = 0.0;
    float iters = 12.0 + floor(gIntensity * 14.0);

    for (int i = 0; i < 26; i++) {
        if (float(i) >= iters) { break; }
        // z = z^2 + seed
        z = float2(z.x * z.x - z.y * z.y, 2.0 * z.x * z.y) + seed;
        float d = dot(z, z);
        trap = min(trap, d);
        if (d > 16.0) { break; }
        esc += 1.0;
    }

    // Orbit-trap rendering rather than escape time: escape time gives flat
    // bands, the trap gives the thin nested veins that survive being warped.
    // A wide trap renders the set as one soft mass. The veins only resolve
    // when the falloff is steep enough that only near-misses of the origin
    // survive — this was 7.0 and the frame was a purple blob.
    float vein = exp(-trap * (55.0 + gIntensity * 90.0));
    float body = esc / max(iters, 1.0);

    float band = spectrum(0.16 + gSlow * 0.22);
    float hi = spectrum(0.58 + gWanderX * 0.14);

    float ink = vein * (1.30 + hi * 2.4) + pow(body, 6.0) * (0.05 + band * 0.28);

    col += theme(frac(body * 0.85 + gSpin * 0.03 + gSlow * 0.2)) * ink * 1.5 * gainComp;
    col += theme(0.28) * 0.010 * gainComp;
    return col;
}

float4 PSDefault(VertData v_in) : TARGET {
    float2 uvRaw = float2(v_in.uv.x, 1.0 - v_in.uv.y);
    float2 uv = uvRaw * 2.0 - 1.0;
    uv.x *= gAspect;
    return float4(scene_julia_tide(uv, uvRaw), 1.0);
}

technique Draw {
    pass {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = PSDefault(v_in);
    }
}
