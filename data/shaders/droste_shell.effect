// GENERATED by shared/groove-spec/tools/build-shaders.mjs from shared/groove-spec/scenes/droste_shell.gsl
// Do not edit by hand — edit the .gsl source and re-run the generator.
uniform float4x4 ViewProj;

uniform float2 gResolution;
uniform float  gTime;
uniform float  gAspect;
uniform float  gBass;
uniform float  gMid;
uniform float  gTreble;
uniform float  gLevel;
uniform float  gBeat;
uniform float  gPulse;
// Persistent state, integrated on the host and handed in — a shader keeps
// nothing between frames. gSpin only accumulates (never resets, so a scene
// keyed to it never repeats); gTurn latches on bass then relaxes; gWander*
// eases to a new target on each beat; gSlow tracks position within the track.
// Keying motion to these is what makes a scene evolve rather than oscillate.
uniform float  gSpin;
uniform float  gTurn;
uniform float  gWanderX;
uniform float  gWanderY;
uniform float  gSlow;

uniform float  gIntensity;
uniform float  gReactivity;
uniform float3 gColA;
uniform float3 gColB;
uniform float3 gColC;
uniform float3 gColD;
uniform float3 gColE;
uniform float  gColCount;
uniform int    gOctaves;
uniform float  gFreqLo;
uniform float  gFreqHi;

uniform texture2d gSpectrum;
uniform texture2d gWave;
uniform texture2d gFeedback;

sampler_state linearClamp {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in) {
    VertData v_out;
    v_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    v_out.uv  = v_in.uv;
    return v_out;
}

// NOTE: no overloading. OBS's effect parser matches functions by name only
// (effect-parser.c, ep_getfunc) and returns the first match, so a second
// gmod taking float2 would never be reached and every vector call would
// silently bind to the scalar body.
float gmod(float a, float b)      { return a - b * floor(a / b); }
float2 gmod2(float2 a, float2 b)  { return a - b * floor(a / b); }

// Screen-space derivatives. Spelled three different ways across the dialects,
// so scenes use the neutral names.
#define gddx(x) ddx(x)
#define gddy(x) ddy(x)
#define gfwidth(x) fwidth(x)

float2 rotate(float2 p, float a) {
    float s = sin(a), c = cos(a);
    return float2(p.x * c - p.y * s, p.x * s + p.y * c);
}

float hash11(float p) {
    p = frac(p * 0.1031);
    p *= p + 33.33;
    p *= p + p;
    return frac(p);
}

float hash21(float2 p) {
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, float3(p3.y, p3.z, p3.x) + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float vnoise(float2 p) {
    float2 i = floor(p), f = frac(p);
    f = f * f * (3.0 - 2.0 * f);
    float a = hash21(i);
    float b = hash21(i + float2(1.0, 0.0));
    float c = hash21(i + float2(0.0, 1.0));
    float d = hash21(i + float2(1.0, 1.0));
    return lerp(lerp(a, b, f.x), lerp(c, d, f.x), f.y);
}

float fbm(float2 p, int octaves) {
    float sum = 0.0, amp = 0.5, norm = 0.0;
    for (int i = 0; i < 6; i++) {
        if (i >= octaves) break;
        sum += vnoise(p) * amp;
        norm += amp;
        p = rotate(p, 0.5) * 2.02;
        amp *= 0.5;
    }
    return sum / max(norm, 0.00001);
}

// The scene's own previous frame — see the GLSL prelude for what it is for.
// The v flip is load-bearing. Metal and the OBS/HLSL path write render targets
// with a top-left origin but hand the scene a bottom-left uvRaw, so sampling the
// previous frame at p reads it upside down.
//
// This is not cosmetic. With F the flip, applying F.R(theta) twice gives
// R(-theta).R(theta) = identity — so differential rotation, the whole point of
// the feedback idiom, cancelled to nothing on these two backends, and every
// long-memory scene converged to a top-bottom mirror of itself. Only GLSL was
// ever correct. Post.metal already carried this fix and a comment; the scene
// prelude never got the same treatment.
float3 feedback(float2 p) {
    float2 f = clamp(p, float2(0.0, 0.0), float2(1.0, 1.0));
    return gFeedback.Sample(linearClamp, float2(f.x, 1.0 - f.y)).rgb;
}

float3 themePick(float i) {
    if (i < 0.5) return gColA;
    if (i < 1.5) return gColB;
    if (i < 2.5) return gColC;
    if (i < 3.5) return gColD;
    return gColE;
}

float3 theme(float t) {
    float n = max(gColCount, 2.0);
    float s = frac(t) * n;
    float i = floor(s);
    float nx = i + 1.0 >= n ? 0.0 : i + 1.0;
    return lerp(themePick(i), themePick(nx), s - i);
}

// gFreqLo/gFreqHi window the spectrum so "bass focus vs full spectrum" is one
// control that every scene inherits.
float spectrum(float x) {
    float t = lerp(gFreqLo, gFreqHi, clamp(x, 0.0, 1.0));
    return gSpectrum.Sample(linearClamp, float2(clamp(t, 0.0, 1.0), 0.5)).r;
}
float wave(float x)     { return gWave.Sample(linearClamp, float2(clamp(x, 0.0, 1.0), 0.5)).r * 2.0 - 1.0; }

// Droste Shell — a self-similar spiral staircase that falls into its own middle.
//
// Log-polar space: u = log(r) - turns * (angle / 2pi). Bands of constant u are
// spirals, and shifting u by one whole unit maps the picture onto a scaled copy
// of itself, so the figure repeats inward forever at a fixed ratio.
//
// The feedback transform is chosen to be that same map, scaled down: each frame
// the previous image is turned and shrunk by a fraction of one Droste step, so
// old structure slides *along* the spiral into the middle and re-emerges at the
// rim. Nothing here recomputes from the clock; the descent is continuous.
//
// The atan2 branch cut is handled the only way it can be: `turns` is a whole
// number, so u shifts by exactly `turns` across the cut, and only frac(u) is
// ever used downstream — never floor(u), never a hash of it.
//
// gIntensity: how tightly the spiral winds.
//
// @moods trippy, ambient
// @tier  pro
// @cost  3
// @trail 0.07
float3 scene_droste_shell(float2 uv, float2 uvRaw) {
    float2 c = uvRaw - 0.5;
    c.x *= gAspect;
    float rad = length(c) * 2.0;

    // ── Differential rotation ────────────────────────────────────────────────
    // A pure spiral zoom would be rigid. Varying the turn rate with radius
    // makes the inner staircase overtake the outer one, so the arms stretch and
    // braid instead of revolving as a single plate.
    float twist = 0.6 + gIntensity * 1.1;
    float rot = 0.0038 * twist * (1.0 / (0.72 + rad * 0.95))
              * (0.72 + 0.30 * sin(gSpin * 0.37 + rad * 1.4))
              + 0.0011 * sin(gSpin * 0.13);

    // Contraction just under 1 — one Droste step takes many seconds to
    // traverse, which is the difference between a descent and a tunnel.
    float zoom = 0.9982 + 0.0012 * sin(rad * 1.9 - gSpin * 0.28) + gTurn * 0.0024;

    float2 q = rotate(c, rot) * zoom + float2(gWanderX, gWanderY) * 0.0012;
    q.x /= gAspect;

    // Border fade. With zoom below 1 the image flows outward and off-frame,
    // where feedback() clamps and resamples the border pixel forever — a hard
    // bright band down each side. This is a *product* of two per-axis falloffs
    // (exp of a sum is a product of exps), never max(), which masks a visibly
    // rectangular hole.
    //
    // Superelliptic rather than smoothstep: smoothstep has a kink in its
    // derivative at each edge, and multiplying that kink into the buffer every
    // frame for two seconds etches the outline of a rounded rectangle across
    // the picture. An exponential is smooth everywhere and leaves nothing.
    float2 fq = abs(q) * 2.0;
    float inside = exp(-(pow(fq.x, 10.0) + pow(fq.y, 10.0)) * 3.0);
    float decay = 0.9850;
    float3 col = feedback(q + 0.5) * decay * inside;
    float gainComp = 1.0 - decay;

    // ── Log-polar coordinates ────────────────────────────────────────────────
    // r is floored well above zero: log(r) near the origin is a huge number and
    // cos() of it aliases into noise. The centre is masked out below anyway.
    float r = max(rad, 0.035);
    float a = atan2(c.y, c.x);
    float turns = 3.0;                     // whole turns per Droste step
    float step0 = 0.62 + gIntensity * 0.30;

    float u = log(r) / step0 - turns * (a * 0.15915494) + gSpin * 0.045 + gSlow * 0.5;
    float uf = frac(u);                    // safe across the branch cut

    // Six-fold arms riding on the spiral. Integer harmonics of the angle are
    // exactly periodic, so the cut can never surface as a seam.
    float arms = 0.55 + 0.45 * sin(6.0 * a + gSpin * 0.40)
                      * cos(3.0 * a - gSpin * 0.23);

    // The tread of the staircase: a soft band around one value of frac(u),
    // sharpened by the audio's brightness rather than its transients.
    float hi = spectrum(0.58 + gWanderX * 0.15);
    float tread = exp(-pow(abs(uf - 0.5), 2.0) * (52.0 + hi * 30.0));

    // A thinner riser line, anti-aliased so the deep, tightly wound copies near
    // the middle stay legible instead of moiring. The line carries most of the
    // light: broad soft bands are the first thing the warp destroys.
    float lw = gfwidth(uf) * 1.8 + 0.006;
    float riser = 1.0 - smoothstep(0.0, lw * 2.0, abs(uf - 0.16));

    // Break the riser into arcs. Unmodulated it draws a continuous closed curve
    // per Droste step, and once the feedback has averaged a few of those the
    // spiral pitch is no longer readable — the frame is a set of plain
    // concentric rings. Five-fold, integer, so the branch cut stays invisible.
    riser *= 0.30 + 0.70 * (0.5 + 0.5 * sin(5.0 * a + gSpin * 0.30));

    // Centre and rim masks. Without the inner one the singularity at r = 0 is a
    // permanent white pixel that the feedback smears into a comet — and the
    // middle is also where the turn rate is highest, so nothing fine survives
    // there anyway. Better an open eye than a bright smudge.
    float mask = smoothstep(0.09, 0.30, rad) * (1.0 - smoothstep(0.80, 1.35, rad));

    float band = spectrum(0.16 + gSlow * 0.22);
    float ink = mask * (tread * arms * (0.22 + band * 0.85) + riser * (0.55 + hi * 1.20));

    // Off-centre glow: something asymmetric for the shear to drag, so the
    // rotation is visible rather than implied.
    float2 gp = c - float2(gWanderX, gWanderY) * 0.30;
    ink += exp(-dot(gp, gp) * 22.0) * (0.10 + gTurn * 0.26);

    col += theme(frac(uf * 0.65 + gSlow * 0.28 + gSpin * 0.03)) * ink * 2.4 * gainComp;
    col += theme(0.20) * 0.011 * gainComp;
    return col;
}

float4 PSDefault(VertData v_in) : TARGET {
    float2 uvRaw = float2(v_in.uv.x, 1.0 - v_in.uv.y);
    float2 uv = uvRaw * 2.0 - 1.0;
    uv.x *= gAspect;
    return float4(scene_droste_shell(uv, uvRaw), 1.0);
}

technique Draw {
    pass {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = PSDefault(v_in);
    }
}
