// GENERATED by shared/groove-spec/tools/build-shaders.mjs from shared/groove-spec/scenes/quasi_mandala.gsl
// Do not edit by hand — edit the .gsl source and re-run the generator.
uniform float4x4 ViewProj;

uniform float2 gResolution;
uniform float  gTime;
uniform float  gAspect;
uniform float  gBass;
uniform float  gMid;
uniform float  gTreble;
uniform float  gLevel;
uniform float  gBeat;
uniform float  gPulse;
// Persistent state, integrated on the host and handed in — a shader keeps
// nothing between frames. gSpin only accumulates (never resets, so a scene
// keyed to it never repeats); gTurn latches on bass then relaxes; gWander*
// eases to a new target on each beat; gSlow tracks position within the track.
// Keying motion to these is what makes a scene evolve rather than oscillate.
uniform float  gSpin;
uniform float  gTurn;
uniform float  gWanderX;
uniform float  gWanderY;
uniform float  gSlow;

uniform float  gIntensity;
uniform float  gReactivity;
uniform float3 gColA;
uniform float3 gColB;
uniform float3 gColC;
uniform float3 gColD;
uniform float3 gColE;
uniform float  gColCount;
uniform int    gOctaves;
uniform float  gFreqLo;
uniform float  gFreqHi;

uniform texture2d gSpectrum;
uniform texture2d gWave;
uniform texture2d gFeedback;

sampler_state linearClamp {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in) {
    VertData v_out;
    v_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    v_out.uv  = v_in.uv;
    return v_out;
}

// NOTE: no overloading. OBS's effect parser matches functions by name only
// (effect-parser.c, ep_getfunc) and returns the first match, so a second
// gmod taking float2 would never be reached and every vector call would
// silently bind to the scalar body.
float gmod(float a, float b)      { return a - b * floor(a / b); }
float2 gmod2(float2 a, float2 b)  { return a - b * floor(a / b); }

// Screen-space derivatives. Spelled three different ways across the dialects,
// so scenes use the neutral names.
#define gddx(x) ddx(x)
#define gddy(x) ddy(x)
#define gfwidth(x) fwidth(x)

float2 rotate(float2 p, float a) {
    float s = sin(a), c = cos(a);
    return float2(p.x * c - p.y * s, p.x * s + p.y * c);
}

float hash11(float p) {
    p = frac(p * 0.1031);
    p *= p + 33.33;
    p *= p + p;
    return frac(p);
}

float hash21(float2 p) {
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, float3(p3.y, p3.z, p3.x) + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float vnoise(float2 p) {
    float2 i = floor(p), f = frac(p);
    f = f * f * (3.0 - 2.0 * f);
    float a = hash21(i);
    float b = hash21(i + float2(1.0, 0.0));
    float c = hash21(i + float2(0.0, 1.0));
    float d = hash21(i + float2(1.0, 1.0));
    return lerp(lerp(a, b, f.x), lerp(c, d, f.x), f.y);
}

float fbm(float2 p, int octaves) {
    float sum = 0.0, amp = 0.5, norm = 0.0;
    for (int i = 0; i < 6; i++) {
        if (i >= octaves) break;
        sum += vnoise(p) * amp;
        norm += amp;
        p = rotate(p, 0.5) * 2.02;
        amp *= 0.5;
    }
    return sum / max(norm, 0.00001);
}

// The scene's own previous frame — see the GLSL prelude for what it is for.
// The v flip is load-bearing. Metal and the OBS/HLSL path write render targets
// with a top-left origin but hand the scene a bottom-left uvRaw, so sampling the
// previous frame at p reads it upside down.
//
// This is not cosmetic. With F the flip, applying F.R(theta) twice gives
// R(-theta).R(theta) = identity — so differential rotation, the whole point of
// the feedback idiom, cancelled to nothing on these two backends, and every
// long-memory scene converged to a top-bottom mirror of itself. Only GLSL was
// ever correct. Post.metal already carried this fix and a comment; the scene
// prelude never got the same treatment.
float3 feedback(float2 p) {
    float2 f = clamp(p, float2(0.0, 0.0), float2(1.0, 1.0));
    return gFeedback.Sample(linearClamp, float2(f.x, 1.0 - f.y)).rgb;
}

float3 themePick(float i) {
    if (i < 0.5) return gColA;
    if (i < 1.5) return gColB;
    if (i < 2.5) return gColC;
    if (i < 3.5) return gColD;
    return gColE;
}

float3 theme(float t) {
    float n = max(gColCount, 2.0);
    float s = frac(t) * n;
    float i = floor(s);
    float nx = i + 1.0 >= n ? 0.0 : i + 1.0;
    return lerp(themePick(i), themePick(nx), s - i);
}

// gFreqLo/gFreqHi window the spectrum so "bass focus vs full spectrum" is one
// control that every scene inherits.
float spectrum(float x) {
    float t = lerp(gFreqLo, gFreqHi, clamp(x, 0.0, 1.0));
    return gSpectrum.Sample(linearClamp, float2(clamp(t, 0.0, 1.0), 0.5)).r;
}
float wave(float x)     { return gWave.Sample(linearClamp, float2(clamp(x, 0.0, 1.0), 0.5)).r * 2.0 - 1.0; }

// Quasi Mandala — a quasiperiodic interference figure, sheared into a rosette.
//
// Seven plane waves at equally spaced headings sum to a quasicrystal: N-fold
// rotational symmetry with no translational period, so the pattern never
// repeats however far it runs. That is the symmetric half of the brief.
//
// What keeps it from being wallpaper is that the seven headings precess and
// each wave carries its own slow phase rate off gSpin, so the interference
// nodes migrate continuously — cells open, merge and close, and the figure
// reorganises over tens of seconds without ever snapping. The wave origin also
// sits slightly off the frame centre the feedback rotates about, which is the
// asymmetry the shear has to drag; a perfectly centred symmetric injector under
// rotation looks like nothing happened at all.
//
// No beat impulse anywhere.
//
// gIntensity: how strongly the rotation rate varies across the frame.
//
// @moods geometric, trippy
// @tier  free
// @cost  3
// @trail 0.06
float3 scene_quasi_mandala(float2 uv, float2 uvRaw) {
    float2 c = uvRaw - 0.5;
    c.x *= gAspect;
    float rad = length(c) * 2.0;

    // ── Differential rotation ────────────────────────────────────────────────
    // Inner radii turn faster than outer ones, and the profile itself breathes
    // on gSpin. Applied to the scene's own previous frame this is a shear, and
    // a shear compounded over hundreds of frames is what bends straight
    // interference fringes into curved arms.
    //
    // The 1/r profile is deliberately gentle. An earlier version used
    // 1/(0.38 + 1.55r), which turns the middle of the frame through eighty
    // degrees inside one memory time constant and grinds the fringes into a
    // featureless white disc. The fringes are the scene.
    float twist = 0.55 + gIntensity * 1.2;
    float rot = 0.0034 * twist * (1.0 / (0.70 + rad * 1.10))
              * (0.66 + 0.38 * sin(gSpin * 0.53 + rad * 2.4))
              - 0.0009 * sin(gSpin * 0.21 + rad * 0.7);

    // Just under 1, so material creeps outward and dissolves at the border
    // rather than draining into a point. gTurn is bass-latched and relaxes over
    // about half a second — it reads as the figure drawing breath.
    float zoom = 0.9987
               + 0.0016 * sin(rad * 2.2 - gSpin * 0.45)
               + gTurn * 0.0022 * (0.8 - rad * 0.35);

    float2 q = rotate(c, rot) * zoom + float2(gWanderX, gWanderY) * 0.0016;
    q.x /= gAspect;

    // Border fade. With zoom below 1 the image flows outward and off-frame,
    // where feedback() clamps and resamples the border pixel forever — a hard
    // bright band down each side. This is a *product* of two per-axis falloffs
    // (exp of a sum is a product of exps), never max(), which masks a visibly
    // rectangular hole.
    //
    // Superelliptic rather than smoothstep: smoothstep has a kink in its
    // derivative at each edge, and multiplying that kink into the buffer every
    // frame for two seconds etches the outline of a rounded rectangle across
    // the picture. An exponential is smooth everywhere and leaves nothing.
    float2 fq = abs(q) * 2.0;
    float inside = exp(-(pow(fq.x, 10.0) + pow(fq.y, 10.0)) * 3.0);

    // Steady state of col = col * decay + inject is inject / (1 - decay), so
    // every injection below is multiplied by (1 - decay).
    // Shorter memory than the rest of the set. Interference fringes are fine
    // and high-contrast; integrating them over a second and a half averages
    // adjacent bright and dark fringes together and the figure turns into a
    // smooth disc. About half a second is as long as this pattern survives.
    float decay = 0.9740;
    float3 col = feedback(q + 0.5) * decay * inside;
    float gainComp = 1.0 - decay;

    // ── The quasicrystal ─────────────────────────────────────────────────────
    // Seven headings over a half turn gives fourteen-fold symmetry, about an
    // origin the wander walk displaces slightly from the centre the feedback
    // turns about — that displacement is the asymmetry the shear drags.
    //
    // Count the fringes that actually land in view. At a scale of 7.5 the wave
    // period is 0.84 across a frame 1.78 wide — barely two fringes, which is
    // not a quasicrystal, it is a bullseye, and that is exactly what the first
    // version rendered. 34 puts about ten across the frame, which is where the
    // fourteen-fold structure becomes legible.
    //
    // The offset has to shrink to match. At this frequency a displacement of
    // 0.06 slides the fringes by two whole periods inside one memory time, and
    // superposing a pattern with a shifted copy of itself is precisely how to
    // erase it. 0.018 is visible and survives.
    float2 p = (c - float2(gWanderX, gWanderY) * 0.018) * (34.0 + gSlow * 6.0);
    float sum = 0.0;
    for (int i = 0; i < 7; i++) {
        float fi = float(i);
        float a = 3.14159265 * fi / 7.0 + gSpin * 0.035;
        float2 d = float2(cos(a), sin(a));
        // The fixed 2.399 spread matters. With every wave starting in phase the
        // sum near the origin is a Bessel profile — concentric rings — and the
        // fourteen-fold cells only appear far out. Detuning the phases breaks
        // that centre and makes the whole frame quasiperiodic.
        sum += cos(dot(d, p) + fi * 2.399 + gSpin * 0.17 * (1.0 + fi * 0.09));
    }
    sum /= 7.0;

    // Two readings of the same field: bright nodes where the waves add, and a
    // hairline along the zero set. gfwidth keeps the line about one pixel wide
    // at any resolution, so the fringes never alias into grey mush.
    float nodes = smoothstep(0.46, 0.68, sum);
    float lw = gfwidth(sum) * 1.6 + 0.008;
    float lines = 1.0 - smoothstep(0.0, lw * 2.6, abs(sum + 0.04));

    // A broad envelope so the figure has an edge and reads as a mandala rather
    // than as tiled wallpaper — and a hole in the middle, because the point the
    // rotation turns fastest about is the one place fine detail cannot survive.
    // Filling it just produces a white disc with a mandala around it.
    float env = exp(-rad * rad * 0.45) * smoothstep(0.03, 0.20, rad);

    float band = spectrum(0.14 + gSlow * 0.26);
    float hi = spectrum(0.60 + gWanderX * 0.14);

    float ink = env * (nodes * (0.30 + band * 1.00) + lines * (0.40 + hi * 1.10));

    col += theme(frac(sum * 0.40 + rad * 0.22 + gSpin * 0.035 + gSlow * 0.24))
         * ink * 2.4 * gainComp;

    // Embers, so a quiet passage settles toward a glow rather than to nothing.
    col += theme(0.48) * 0.011 * gainComp;

    // No global multiply here: it would sit inside the feedback path and
    // compound into the decay every frame. Exposure belongs in the post chain.
    return col;
}

float4 PSDefault(VertData v_in) : TARGET {
    float2 uvRaw = float2(v_in.uv.x, 1.0 - v_in.uv.y);
    float2 uv = uvRaw * 2.0 - 1.0;
    uv.x *= gAspect;
    return float4(scene_quasi_mandala(uv, uvRaw), 1.0);
}

technique Draw {
    pass {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = PSDefault(v_in);
    }
}
